---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SiteNav from '../../../components/SiteNav.astro'
import { locales, t } from '../../../i18n'

export function getStaticPaths() {
  return locales.map(({ locale, lang }) => ({ params: { locale }, props: { lang } }))
}

const { lang } = Astro.props
const i18n = t(lang)

// Legacy site B.R.E.A.D. scores (bomb/removal/evasion/aggro/diversity/overall/tags),
// keyed by set code -> oracleId -> bread, embedded for whichever sets already have a
// prerelease-data entry. Sets without one simply won't have a matching key client-side,
// and only Karn's power_score renders for those cards.
const legacyBreadEntries = await getCollection('prerelease-data')
const legacyBreadBySet: Record<string, Record<string, unknown>> = {}
for (const entry of legacyBreadEntries) {
  legacyBreadBySet[entry.data.setCode.toUpperCase()] = Object.fromEntries(
    entry.data.cards.map(c => [c.oracleId, c.bread])
  )
}
---

<BaseLayout title={i18n.sealedPageTitle} description={i18n.sealedPageDescription} lang={lang}>
  <div style="background-image: radial-gradient(circle, rgba(43,46,51,0.6) 1px, transparent 1px); background-size: 24px 24px; min-height: 100vh;">

    <SiteNav lang={lang} activePage="sealed" />

    <script type="application/json" id="legacy-bread-data" set:html={JSON.stringify(legacyBreadBySet)} />

    <!-- STAGE 1: Setup -->
    <main id="sealed-setup-stage" class="min-h-screen flex flex-col items-center justify-center pt-20 pb-10 px-6">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <h1 class="text-4xl sm:text-5xl font-bold text-on-surface leading-tight mb-4">{i18n.sealedHeading}</h1>
        <p class="text-on-surface-variant text-lg">{i18n.sealedSub}</p>
        <p class="text-xs text-on-surface-variant/50 mt-3">{i18n.sealedDisclaimer}</p>
      </div>

      <!-- Controls -->
      <div class="max-w-4xl mx-auto glass-panel rounded-2xl p-6 flex flex-wrap items-end gap-4 justify-center">
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-xs uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedSetLabel}</span>
          <select id="sealed-set-select" class="bg-surface border border-white/10 rounded-lg px-3 py-2 text-on-surface text-sm min-w-[180px]"></select>
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-xs uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedPackCountLabel}</span>
          <input id="sealed-pack-count" type="number" min="1" max="6" value="6" class="bg-surface border border-white/10 rounded-lg px-3 py-2 text-on-surface text-sm w-24" />
        </label>
        <button id="sealed-generate-btn" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-sm hover:bg-primary-container transition-colors">
          {i18n.sealedGenerateButton}
        </button>
        <button id="sealed-resume-btn" class="hidden px-5 py-2.5 rounded-xl border border-primary/40 text-primary font-bold text-sm hover:bg-primary/10 transition-colors">
          {i18n.sealedResumeButton}
        </button>
      </div>
      <p id="sealed-resume-hint" class="hidden max-w-4xl mx-auto text-center text-xs text-on-surface-variant/50 mt-3">
        {i18n.sealedResumeHint}
      </p>
    </main>

    <!-- STAGE 2: Board (full screen) -->
    <div id="sealed-board-stage" class="hidden fixed inset-0 pt-20 flex flex-col">
      <!-- Toolbar -->
      <div class="flex flex-wrap items-center gap-4 px-4 py-2.5 border-b border-white/10 bg-surface/90 backdrop-blur">
        <button id="sealed-back-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors">
          ← {i18n.sealedSetLabel}
        </button>
        <div class="h-6 w-px bg-white/10"></div>
        <div id="sealed-stats" class="flex items-center gap-4">
          <div id="sealed-pool-count-tile" class="flex items-baseline gap-1.5"><span class="text-lg font-bold text-primary">0</span><span class="text-[11px] uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedCardCountLabel}</span></div>
          <div id="sealed-placed-count-tile" class="flex items-baseline gap-1.5"><span class="text-lg font-bold text-primary">0</span><span class="text-[11px] uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedPlacedCountLabel}</span></div>
          <div id="sealed-deck-count-tile" class="flex items-baseline gap-1.5"><span class="text-lg font-bold text-primary">0</span><span class="text-[11px] uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedDeckCountLabel}</span></div>
          <div id="sealed-sideboard-count-tile" class="flex items-baseline gap-1.5"><span class="text-lg font-bold text-primary">0</span><span class="text-[11px] uppercase tracking-widest text-on-surface-variant/60">{i18n.sealedSideboardCountLabel}</span></div>
        </div>
        <button
          id="sealed-autobuild-btn"
          class="ml-auto px-4 py-1.5 rounded-lg border border-primary/40 text-primary font-bold text-xs hover:bg-primary/10 transition-colors disabled:opacity-50 disabled:cursor-wait"
        >
          {i18n.sealedAutoBuildButton}
        </button>
        <span id="sealed-autobuild-summary" class="text-[11px] text-on-surface-variant/60"></span>
        <button
          id="sealed-blind-toggle"
          class="px-3 py-1.5 rounded-lg border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors"
          aria-pressed="false"
        >
          {i18n.sealedBlindModeActivateLabel}
        </button>
        <button id="sealed-regenerate-btn" class="px-4 py-1.5 rounded-lg bg-primary text-on-primary font-bold text-xs hover:bg-primary-container transition-colors">
          {i18n.sealedRegenerateButton}
        </button>
        <button id="sealed-export-btn" class="px-3 py-1.5 rounded-lg border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors">
          {i18n.sealedExportArenaButton}
        </button>
        <button
          id="sealed-info-btn"
          aria-label={i18n.sealedInfoButton}
          class="w-7 h-7 flex items-center justify-center rounded-full border border-white/10 text-xs font-bold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors"
        >?</button>
        <p id="sealed-lands-note" class="w-full text-center text-[11px] text-on-surface-variant/50 sm:hidden">
          {i18n.sealedLandsNote}
        </p>
      </div>

      <!-- Canvas + drawer -->
      <div class="relative flex-1 min-h-0">
        <div
          id="sealed-viewport"
          class="relative overflow-hidden bg-black/20 h-full w-full"
        >
          <div id="sealed-canvas" class="absolute top-0 left-0" style="transform-origin: 0 0; width: 1px; height: 1px;"></div>

          <p id="sealed-canvas-empty" class="absolute inset-0 flex items-center justify-center text-center text-sm text-on-surface-variant/40 px-8 pointer-events-none">
            {i18n.sealedCanvasEmpty}
          </p>

          <!-- Canvas toolbar -->
          <div class="absolute top-3 left-3 flex items-center gap-2 z-20 flex-wrap">
            <span id="sealed-zoom-label" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant">100%</span>
            <button id="sealed-reset-view-btn" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors">
              {i18n.sealedResetView}
            </button>
            <span class="w-px h-5 bg-white/10"></span>
            <button
              id="sealed-select-mode-btn"
              aria-pressed="false"
              class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors"
            >
              ☑ {i18n.sealedSelectModeButton}
            </button>
            <span class="w-px h-5 bg-white/10"></span>
            <button id="sealed-add-note-btn" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors">
              📝 {i18n.sealedAddSticky}
            </button>
            <button id="sealed-add-curve-widget-btn" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors">
              📈 {i18n.sealedAddCurveWidget}
            </button>
            <button id="sealed-add-types-widget-btn" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors">
              🥧 {i18n.sealedAddTypesWidget}
            </button>
            <button id="sealed-add-draw-widget-btn" class="px-2.5 py-1 rounded-full bg-surface/80 border border-white/10 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors">
              🎲 {i18n.sealedAddDrawWidget}
            </button>
            <span class="px-2.5 py-1 rounded-full bg-surface/60 border border-white/10 text-[11px] text-on-surface-variant/50 hidden lg:inline-block">
              {i18n.sealedPanHint}
            </span>
          </div>

          <!-- Bulk selection action bar -->
          <div
            id="sealed-selection-bar"
            class="hidden absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 bg-surface/95 backdrop-blur border border-white/10 rounded-full px-3 py-2 shadow-2xl"
          >
            <span id="sealed-selection-count" class="text-xs font-semibold text-on-surface-variant px-1">0</span>
            <button id="sealed-selection-to-deck-btn" class="px-3 py-1.5 rounded-full bg-primary text-on-primary font-bold text-xs hover:bg-primary-container transition-colors">
              {i18n.sealedSelectionMarkDeck}
            </button>
            <button id="sealed-selection-to-sideboard-btn" class="px-3 py-1.5 rounded-full border border-white/10 text-on-surface-variant font-bold text-xs hover:text-on-surface transition-colors">
              {i18n.sealedSelectionToSideboard}
            </button>
            <button id="sealed-selection-clear-btn" class="px-3 py-1.5 rounded-full border border-white/10 text-on-surface-variant font-bold text-xs hover:text-on-surface transition-colors">
              {i18n.sealedSelectionClear}
            </button>
          </div>
        </div>

        <!-- Drawer toggle tab -->
        <button
          id="sealed-drawer-toggle"
          class="absolute top-1/2 -translate-y-1/2 right-0 z-30 px-3 py-4 rounded-l-xl bg-primary text-on-primary font-bold text-xs [writing-mode:vertical-rl] hover:bg-primary-container transition-colors"
        >
          {i18n.sealedDrawerToggle} (<span id="sealed-drawer-count">0</span>)
        </button>

        <!-- Drawer panel -->
        <aside
          id="sealed-drawer"
          class="absolute top-0 right-0 h-full w-full sm:w-[360px] bg-surface border-l border-white/10 overflow-y-auto z-40 transition-transform duration-200 translate-x-full"
        >
          <div class="sticky top-0 bg-surface/95 backdrop-blur px-4 py-3 border-b border-white/10 flex items-center justify-between">
            <h3 class="font-bold text-sm text-on-surface">{i18n.sealedDrawerToggle}</h3>
            <button id="sealed-drawer-close" class="text-on-surface-variant hover:text-on-surface text-sm px-2">✕</button>
          </div>
          <div id="sealed-drawer-list" class="p-3 flex flex-col gap-2"></div>
          <p id="sealed-drawer-empty" class="hidden text-center text-sm text-on-surface-variant/50 py-10 px-4">{i18n.sealedDrawerEmpty}</p>
        </aside>

        <!-- Sideboard toggle tab -->
        <button
          id="sealed-sideboard-toggle"
          class="absolute top-1/2 -translate-y-1/2 left-0 z-30 px-3 py-4 rounded-r-xl bg-surface border border-white/10 text-on-surface-variant font-bold text-xs [writing-mode:vertical-rl] hover:text-on-surface transition-colors"
        >
          {i18n.sealedSideboardToggle} (<span id="sealed-sideboard-count">0</span>)
        </button>

        <!-- Sideboard panel -->
        <aside
          id="sealed-sideboard"
          class="absolute top-0 left-0 h-full w-full sm:w-[360px] bg-surface border-r border-white/10 overflow-y-auto z-40 transition-transform duration-200 -translate-x-full"
        >
          <div class="sticky top-0 bg-surface/95 backdrop-blur px-4 py-3 border-b border-white/10 flex items-center justify-between">
            <h3 class="font-bold text-sm text-on-surface">{i18n.sealedSideboardToggle}</h3>
            <button id="sealed-sideboard-close" class="text-on-surface-variant hover:text-on-surface text-sm px-2">✕</button>
          </div>
          <div id="sealed-sideboard-list" class="p-3 flex flex-col gap-2"></div>
          <p id="sealed-sideboard-empty" class="hidden text-center text-sm text-on-surface-variant/50 py-10 px-4">{i18n.sealedSideboardEmpty}</p>
        </aside>
      </div>
    </div>

    <!-- Auto-build: deck option picker -->
    <div id="sealed-autobuild-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-6">
      <div class="glass-panel rounded-2xl max-w-3xl w-full max-h-[85vh] overflow-y-auto p-6">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-bold text-on-surface">{i18n.sealedAutoBuildChooseTitle}</h3>
          <button id="sealed-autobuild-modal-close" class="text-on-surface-variant hover:text-on-surface text-sm px-2">✕</button>
        </div>
        <p class="text-xs text-on-surface-variant/60 mb-4">{i18n.sealedAutoBuildChooseSub}</p>
        <div id="sealed-autobuild-options" class="grid gap-3 sm:grid-cols-2"></div>
      </div>
    </div>

    <!-- Export to MTG Arena -->
    <div id="sealed-export-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-6">
      <div class="glass-panel rounded-2xl max-w-lg w-full max-h-[85vh] overflow-y-auto p-6">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-bold text-on-surface">{i18n.sealedExportModalTitle}</h3>
          <button id="sealed-export-modal-close" class="text-on-surface-variant hover:text-on-surface text-sm px-2">✕</button>
        </div>
        <p class="text-xs text-on-surface-variant/60 mb-3">{i18n.sealedExportModalSub}</p>
        <textarea
          id="sealed-export-textarea"
          readonly
          class="w-full h-64 bg-black/30 border border-white/10 rounded-lg p-3 text-xs text-on-surface font-mono resize-none"
        ></textarea>
        <button id="sealed-export-copy-btn" class="mt-3 px-4 py-2 rounded-lg bg-primary text-on-primary font-bold text-xs hover:bg-primary-container transition-colors">
          {i18n.sealedExportCopyButton}
        </button>
      </div>
    </div>

    <!-- Legend: score pills + quadrant tags + grades explained -->
    <div id="sealed-info-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-6">
      <div class="glass-panel rounded-2xl max-w-lg w-full max-h-[85vh] overflow-y-auto p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-on-surface">{i18n.sealedInfoTitle}</h3>
          <button id="sealed-info-modal-close" class="text-on-surface-variant hover:text-on-surface text-sm px-2">✕</button>
        </div>
        <div class="flex flex-col gap-5 text-sm text-on-surface-variant">
          <section>
            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface-variant/60 mb-2">{i18n.sealedInfoScoreHeading}</h4>
            <ul class="flex flex-col gap-2">
              <li><span class="font-semibold text-on-surface">{i18n.sealedKarnScoreLabel}</span> — {i18n.sealedInfoLimitedScoreDesc}</li>
              <li><span class="font-semibold text-on-surface">{i18n.sealedSiteScoreLabel}</span> — {i18n.sealedInfoBreadScoreDesc}</li>
            </ul>
          </section>
          <section>
            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface-variant/60 mb-2">{i18n.sealedInfoQuadrantHeading}</h4>
            <p class="text-xs text-on-surface-variant/70 mb-2">{i18n.sealedInfoQuadrantIntro}</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2">
                <span class="flex-shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold border bg-emerald-500 text-white border-emerald-200/60">D</span>
                <span><span class="font-semibold text-on-surface">{i18n.sealedQuadrantDevelopLabel}</span> — {i18n.sealedQuadrantDevelopDesc}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="flex-shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold border bg-sky-500 text-white border-sky-200/60">P</span>
                <span><span class="font-semibold text-on-surface">{i18n.sealedQuadrantParityLabel}</span> — {i18n.sealedQuadrantParityDesc}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="flex-shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold border bg-orange-500 text-white border-orange-200/60">A</span>
                <span><span class="font-semibold text-on-surface">{i18n.sealedQuadrantAheadLabel}</span> — {i18n.sealedQuadrantAheadDesc}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="flex-shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold border bg-primary text-on-primary border-primary/60">B</span>
                <span><span class="font-semibold text-on-surface">{i18n.sealedQuadrantBehindLabel}</span> — {i18n.sealedQuadrantBehindDesc}</span>
              </li>
            </ul>
          </section>
          <section>
            <h4 class="text-xs font-bold uppercase tracking-widest text-on-surface-variant/60 mb-2">{i18n.sealedInfoGradeHeading}</h4>
            <p>{i18n.sealedInfoGradeDesc}</p>
          </section>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    #sealed-board-stage.blind-mode .card-scores {
      display: none;
    }
    /* Let our own pointer handlers own pan/zoom/drag instead of the browser's
       native touch scrolling — required for pinch-zoom and finger-drag on tablets. */
    #sealed-viewport, .canvas-card, .canvas-note, .canvas-widget {
      touch-action: none;
    }
    .canvas-card img {
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }
    #sealed-hover-preview {
      transition: opacity 0.1s ease;
    }
    .canvas-card.selected-card {
      outline: 3px solid #38bdf8;
      outline-offset: 2px;
      border-radius: 0.75rem;
    }
  </style>

  <script
    define:vars={{
      i18n: {
        karnScoreLabel: i18n.sealedKarnScoreLabel,
        siteScoreLabel: i18n.sealedSiteScoreLabel,
        breadBombLabel: i18n.breadBombLabel,
        breadRemovalLabel: i18n.breadRemovalLabel,
        breadEvasionLabel: i18n.breadEvasionLabel,
        breadAggroLabel: i18n.breadAggroLabel,
        breadDiversityLabel: i18n.breadDiversityLabel,
        breadOverallLabel: i18n.breadOverallLabel,
        markAsDeck: i18n.sealedMarkAsDeck,
        inDeck: i18n.sealedInDeck,
        toSideboard: i18n.sealedToSideboard,
        blindModeActivateLabel: i18n.sealedBlindModeActivateLabel,
        blindModeDeactivateLabel: i18n.sealedBlindModeDeactivateLabel,
        autoBuildLabel: i18n.sealedAutoBuildButton,
        autoBuildBuilding: i18n.sealedAutoBuildBuilding,
        autoBuildUseDeck: i18n.sealedAutoBuildUseDeck,
        autoBuildAvgScoreLabel: i18n.sealedAutoBuildAvgScoreLabel,
        autoBuildDeckSizeLabel: i18n.sealedAutoBuildDeckSizeLabel,
        autoBuildPowerLabel: i18n.sealedAutoBuildPowerLabel,
        autoBuildCoverageLabel: i18n.sealedAutoBuildCoverageLabel,
        autoBuildSynergyLabel: i18n.sealedAutoBuildSynergyLabel,
        selectedLabel: i18n.sealedSelectedLabel,
        quadrantDevelopLabel: i18n.sealedQuadrantDevelopLabel,
        quadrantParityLabel: i18n.sealedQuadrantParityLabel,
        quadrantAheadLabel: i18n.sealedQuadrantAheadLabel,
        quadrantBehindLabel: i18n.sealedQuadrantBehindLabel,
        addToCanvas: i18n.sealedAddToCanvas,
        toPool: i18n.sealedToPool,
        exportCopyButton: i18n.sealedExportCopyButton,
        exportCopied: i18n.sealedExportCopied,
        autoBuildSimilarityLabel: i18n.sealedAutoBuildSimilarityLabel,
        autoBuildSwapOutLabel: i18n.sealedAutoBuildSwapOutLabel,
        autoBuildSwapInLabel: i18n.sealedAutoBuildSwapInLabel,
        autoBuildConfirmWarning: i18n.sealedAutoBuildConfirmWarning,
        autoBuildConfirmReplace: i18n.sealedAutoBuildConfirmReplace,
        autoBuildCancel: i18n.sealedAutoBuildCancel,
        breadFillerLabel: i18n.breadFillerLabel,
        widgetCurveTitle: i18n.sealedWidgetCurveTitle,
        widgetTypesTitle: i18n.sealedWidgetTypesTitle,
        widgetDrawTitle: i18n.sealedWidgetDrawTitle,
        typeCreatureLabel: i18n.sealedTypeCreatureLabel,
        typeSpellLabel: i18n.sealedTypeSpellLabel,
        typeLandLabel: i18n.sealedTypeLandLabel,
      },
    }}
  >
    // ---- Config ----
    const MIN_SCALE = 0.2
    const MAX_SCALE = 2.5
    const ZOOM_IN_FACTOR = 1.12
    const ZOOM_OUT_FACTOR = 0.88
    const DEFAULT_VIEW = { tx: 80, ty: 60, sc: 1 }
    const TILE_WIDTH = 140
    const TILE_HEIGHT = 210
    const RARITY_ORDER = ['common', 'uncommon', 'rare', 'mythic']

    const legacyBreadDataEl = document.getElementById('legacy-bread-data')
    const legacyBreadBySet = legacyBreadDataEl ? JSON.parse(legacyBreadDataEl.textContent || '{}') : {}

    const setupStage = document.getElementById('sealed-setup-stage')
    const boardStage = document.getElementById('sealed-board-stage')
    const setSelect = document.getElementById('sealed-set-select')
    const packCountInput = document.getElementById('sealed-pack-count')
    const generateBtn = document.getElementById('sealed-generate-btn')
    const resumeBtn = document.getElementById('sealed-resume-btn')
    const resumeHint = document.getElementById('sealed-resume-hint')
    const regenerateBtn = document.getElementById('sealed-regenerate-btn')
    const autoBuildBtn = document.getElementById('sealed-autobuild-btn')
    const autoBuildSummary = document.getElementById('sealed-autobuild-summary')
    const backBtn = document.getElementById('sealed-back-btn')
    const blindToggleBtn = document.getElementById('sealed-blind-toggle')
    const viewport = document.getElementById('sealed-viewport')
    const canvas = document.getElementById('sealed-canvas')
    const canvasEmptyMsg = document.getElementById('sealed-canvas-empty')
    const zoomLabel = document.getElementById('sealed-zoom-label')
    const resetViewBtn = document.getElementById('sealed-reset-view-btn')
    const selectModeBtn = document.getElementById('sealed-select-mode-btn')
    const selectionBar = document.getElementById('sealed-selection-bar')
    const selectionCountEl = document.getElementById('sealed-selection-count')
    const selectionToDeckBtn = document.getElementById('sealed-selection-to-deck-btn')
    const selectionToSideboardBtn = document.getElementById('sealed-selection-to-sideboard-btn')
    const selectionClearBtn = document.getElementById('sealed-selection-clear-btn')
    const addNoteBtn = document.getElementById('sealed-add-note-btn')
