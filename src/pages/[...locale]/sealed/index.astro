    // ---- Booster simulation ----
    function sampleN(arr, n) {
      const picked = []
      const pool = arr.slice()
      for (let i = 0; i < n && pool.length > 0; i++) {
        const idx = Math.floor(Math.random() * pool.length)
        picked.push(pool[idx])
        pool.splice(idx, 1)
      }
      return picked
    }

    function openBooster(rarities) {
      const cards = []
      cards.push(...sampleN(rarities.common || [], 10))
      cards.push(...sampleN(rarities.uncommon || [], 3))
      const rareOrMythic = Math.random() < 0.125 && (rarities.mythic || []).length > 0
        ? sampleN(rarities.mythic, 1)
        : sampleN(rarities.rare || [], 1)
      cards.push(...rareOrMythic)
      return cards
    }

    function generatePoolIds(setData, packCount) {
      const rarities = {}
      for (const rarity of RARITY_ORDER) {
        rarities[rarity] = (setData.rarities[rarity] || []).filter(c => c.bread !== '-')
      }
      const pool = []
      for (let i = 0; i < packCount; i++) pool.push(...openBooster(rarities))
      return pool.map(c => c.oracleId)
    }

    function buildCardsByOracleId(setData) {
      const map = {}
      for (const rarity of RARITY_ORDER) {
        for (const card of setData.rarities[rarity] || []) map[card.oracleId] = card
      }
      return map
    }

    // ---- Rendering ----
    function breadPillClass(tag) {
      const map = {
        B: 'bg-primary/15 text-primary border-primary/30',
        R: 'bg-red-400/15 text-red-300 border-red-400/30',
        E: 'bg-sky-400/15 text-sky-300 border-sky-400/30',
        D: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30',
        A: 'bg-orange-400/15 text-orange-300 border-orange-400/30',
        F: 'bg-white/5 text-on-surface-variant/60 border-white/10',
      }
      return map[tag] || map.F
    }

    function manaCostIcons(manaCost) {
      const symbols = manaCost ? manaCost.match(/\{[^}]+\}/g) : null
      if (!symbols) return ''
      return symbols.map(sym => {
        const slug = sym.slice(1, -1).toLowerCase().replace(/\//g, '')
        return `<i class="ms ms-${slug} ms-cost" aria-label="${sym}"></i>`
      }).join('')
    }

    function pillHtml(code, text, title) {
      return `<span title="${title}" class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold border ${breadPillClass(code)}">${text}</span>`
    }

    function scorePillsHtml(card) {
      const limitedPill = pillHtml(card.bread, `${i18n.karnScoreLabel} ${Number(card.power_score).toFixed(1)}`, i18n.karnScoreLabel)

      const legacy = legacyBreadBySet[currentSetCode] && legacyBreadBySet[currentSetCode][card.oracleId]
      if (!legacy) return limitedPill

      const subPills = [
        ['B', i18n.breadBombLabel, legacy.bomb],
        ['R', i18n.breadRemovalLabel, legacy.removal],
        ['E', i18n.breadEvasionLabel, legacy.evasion],
        ['A', i18n.breadAggroLabel, legacy.aggro],
        ['D', i18n.breadDiversityLabel, legacy.diversity],
      ].map(([code, label, value]) => pillHtml(code, `${code} ${Number(value).toFixed(1)}`, label)).join('')
      const overallPill = pillHtml('F', `${i18n.breadOverallLabel} ${Number(legacy.overall).toFixed(1)}`, i18n.breadOverallLabel)

      return `${limitedPill}${subPills}${overallPill}`
    }

    function makeListRow(card) {
      const el = document.createElement('div')
      el.className = 'card-item glass-panel rounded-xl overflow-hidden flex gap-3 p-2.5 cursor-grab'
      el.draggable = true
      el.dataset.oracleId = card.oracleId
      const img = card.imageUrl
        ? `<div class="w-14 h-14 rounded-lg overflow-hidden flex-shrink-0 bg-black/30"><img src="${card.imageUrl}" alt="${card.name}" class="w-full h-full object-cover object-top" loading="lazy" /></div>`
        : ''
      el.innerHTML = `
        ${img}
        <div class="min-w-0 flex-1">
          <div class="flex items-baseline justify-between gap-2">
            <h4 class="font-semibold text-xs text-on-surface truncate">${card.name}</h4>
            <span class="flex items-center gap-0.5 flex-shrink-0 text-[11px]">${manaCostIcons(card.manaCost)}</span>
          </div>
          <div class="card-scores flex flex-wrap items-center gap-1 mt-1">${scorePillsHtml(card)}</div>
          <div class="flex items-center gap-1.5 mt-1.5">
            <button type="button" class="add-to-canvas-btn px-2 py-1 rounded-md text-[10px] font-bold bg-primary/15 text-primary border border-primary/30 hover:bg-primary/25 transition-colors">${i18n.addToCanvas}</button>
            <button type="button" class="move-list-btn px-2 py-1 rounded-md text-[10px] font-bold bg-white/5 text-on-surface-variant border border-white/10 hover:text-on-surface transition-colors"></button>
          </div>
        </div>
      `
      // Native HTML5 drag still works for desktop mouse users; the buttons above
      // are the tablet/touch-friendly path since dragstart is unreliable on touch.
      el.addEventListener('dragstart', e => {
        e.dataTransfer.effectAllowed = 'move'
        e.dataTransfer.setData('text/plain', card.oracleId)
      })

      el.querySelector('.add-to-canvas-btn').addEventListener('click', e => {
        e.stopPropagation()
        addCardToCanvasDefault(card)
        el.remove()
        updateDrawerEmptyState()
        updateSideboardEmptyState()
        updateStats()
        persistCurrentState()
      })

      el.querySelector('.move-list-btn').addEventListener('click', e => {
        e.stopPropagation()
        const targetList = el.closest('#sealed-sideboard-list') ? drawerList : sideboardList
        targetList.appendChild(el)
        refreshMoveButtonLabel(el)
        updateDrawerEmptyState()
        updateSideboardEmptyState()
        updateStats()
        persistCurrentState()
      })

      return el
    }

    function refreshMoveButtonLabel(el) {
      const btn = el.querySelector('.move-list-btn')
      const inSideboard = !!el.closest('#sealed-sideboard-list')
      btn.textContent = inSideboard ? i18n.toPool : i18n.toSideboard
    }

    function appendListRow(container, card) {
      const el = makeListRow(card)
      container.appendChild(el)
      refreshMoveButtonLabel(el)
      return el
    }

    function viewportCenterCanvasPoint() {
      const r = viewport.getBoundingClientRect()
      const jitterX = (Math.random() - 0.5) * 40
      const jitterY = (Math.random() - 0.5) * 40
      return s2c(r.left + r.width / 2 + jitterX, r.top + r.height / 2 + jitterY)
    }

    // Notes/widgets are much bigger than the small random jitter above, so
    // clicking "Note" then "Curve" then "Types" back-to-back (no dragging in
    // between) landed them all almost exactly on top of each other — visually
    // merging into one unreadable box. Cascade each new one diagonally instead.
    function nextAnnotationPoint() {
      const count = canvas.querySelectorAll('.canvas-note, .canvas-widget').length
      const center = viewportCenterCanvasPoint()
      const cascade = (count % 10) * 36
      return { x: center.x + cascade, y: center.y + cascade }
    }

    // Same overlap problem as notes/widgets: tapping "To Canvas" on several
    // pool rows in a row landed each card almost exactly on top of the last,
    // making them hard to tell apart or click individually. Cascade these too.
    function nextCardPoint() {
      const count = canvas.querySelectorAll('.canvas-card').length
      const center = viewportCenterCanvasPoint()
      const cascade = (count % 10) * 30
      return { x: center.x + cascade, y: center.y + cascade }
    }

    function addCardToCanvasDefault(card) {
      const center = nextCardPoint()
      canvas.appendChild(makeCanvasCardEl(card, center.x - TILE_WIDTH / 2, center.y - TILE_HEIGHT / 2, false))
      canvasEmptyMsg.classList.add('hidden')
    }

    // ---- Sticky notes ----
    function makeStickyNoteEl(id, x, y, text) {
      const el = document.createElement('div')
      el.className = 'canvas-note absolute rounded-lg shadow-xl p-2 cursor-grab select-none flex flex-col'
      el.style.left = x + 'px'
      el.style.top = y + 'px'
      el.style.width = '160px'
      el.style.minHeight = '120px'
      el.style.background = '#f2ca83'
      el.dataset.noteId = id
      // note-text fills the whole box (flex-1) so clicking anywhere in the
      // note's visible area focuses it for typing instead of starting a drag.
      el.innerHTML = `
        <button type="button" class="delete-note-btn absolute top-1 right-1 w-5 h-5 flex items-center justify-center rounded-full bg-black/10 hover:bg-black/20 text-black/60 text-xs font-bold">×</button>
        <div class="note-text flex-1 outline-none pr-5 text-xs text-black/80 whitespace-pre-wrap" contenteditable="true" spellcheck="false">${text || ''}</div>
      `
      el.querySelector('.delete-note-btn').addEventListener('click', e => {
        e.stopPropagation()
        el.remove()
        persistCurrentState()
      })
      const textEl = el.querySelector('.note-text')
      textEl.addEventListener('input', () => persistCurrentState())
      textEl.addEventListener('pointerdown', e => e.stopPropagation())
      makeCanvasItemDraggable(el, '.delete-note-btn, .note-text')
      return el
    }

    function addStickyNote() {
      const center = nextAnnotationPoint()
      const el = makeStickyNoteEl(`note-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`, center.x - 80, center.y - 60, '')
      canvas.appendChild(el)
      canvasEmptyMsg.classList.add('hidden')
      el.querySelector('.note-text').focus()
      persistCurrentState()
    }
    addNoteBtn.addEventListener('click', addStickyNote)

    // ---- Widgets (Mana Curve / Deck Composition / Draw Chances) — live panels
    // reflecting whatever is currently marked "In deck" on the canvas ----
    function currentDeckCards() {
      return Array.from(canvas.querySelectorAll('.canvas-card[data-in-deck="1"]'))
        .map(el => cardsByOracleId[el.dataset.oracleId])
        .filter(Boolean)
    }

    function manaCurveWidgetHtml() {
      const deck = currentDeckCards()
      const buckets = {}
      deck.forEach(c => {
        const b = Math.min(Math.max(Math.round(c.cmc), 0), 7)
        buckets[b] = (buckets[b] || 0) + 1
      })
      const max = Math.max(1, ...Object.values(buckets))
      const cols = [0, 1, 2, 3, 4, 5, 6, 7].map(b => {
        const count = buckets[b] || 0
        const heightPct = count > 0 ? Math.max(Math.round((count / max) * 100), 10) : 0
        const label = b === 7 ? '7+' : String(b)
        return `
          <div class="flex flex-col items-center gap-1 flex-1">
            <div class="w-full flex items-end justify-center" style="height:56px;">
              <div class="w-3.5 rounded-t bg-primary/80" style="height:${heightPct}%;" title="${count}"></div>
            </div>
            <span class="text-[9px] text-on-surface-variant/60">${label}</span>
          </div>
        `
      }).join('')
      return `<div class="flex items-end gap-1">${cols}</div>`
    }

    function typeBucketsFor(deck) {
      let creature = 0, land = 0, spell = 0
      deck.forEach(c => {
        const type = c.typeLine || ''
        if (type.includes('Land')) land++
        else if (type.includes('Creature')) creature++
        else spell++
      })
      return { creature, land, spell }
    }

    function typesWidgetHtml() {
      const deck = currentDeckCards()
      const { creature, land, spell } = typeBucketsFor(deck)
      const total = creature + land + spell
      const segments = [
        { value: creature, color: '#34d399' },
        { value: spell, color: '#38bdf8' },
        { value: land, color: '#f2ca83' },
      ].filter(s => s.value > 0)

      const cx = 100, cy = 92, r = 76, sw = 16
      let f = 0
      const arcs = segments.map(seg => {
        const f0 = f
        f += total > 0 ? seg.value / total : 0
        const a0 = (180 - 180 * f0) * Math.PI / 180
        const a1 = (180 - 180 * f) * Math.PI / 180
        const p0 = { x: cx + r * Math.cos(a0), y: cy - r * Math.sin(a0) }
        const p1 = { x: cx + r * Math.cos(a1), y: cy - r * Math.sin(a1) }
        return `<path d="M ${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A ${r} ${r} 0 0 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}" stroke="${seg.color}" stroke-width="${sw}" fill="none" />`
      }).join('')

      return `
        <svg viewBox="0 0 200 104" class="w-full">
          <path d="M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}" stroke="rgba(255,255,255,0.08)" stroke-width="${sw}" fill="none" />
          ${arcs}
          <text x="${cx}" y="${cy - 6}" text-anchor="middle" fill="currentColor" class="text-on-surface" style="font-size:24px;font-weight:700;">${total}</text>
        </svg>
        <div class="flex flex-col gap-1 text-[10px] mt-1">
          <div class="flex items-center justify-between"><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full" style="background:#34d399"></span>${i18n.typeCreatureLabel}</span><span class="font-semibold text-on-surface">${creature} <span class="text-on-surface-variant/50">(15–17)</span></span></div>
          <div class="flex items-center justify-between"><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full" style="background:#38bdf8"></span>${i18n.typeSpellLabel}</span><span class="font-semibold text-on-surface">${spell} <span class="text-on-surface-variant/50">(5–8)</span></span></div>
          <div class="flex items-center justify-between"><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full" style="background:#f2ca83"></span>${i18n.typeLandLabel}</span><span class="font-semibold text-on-surface">${land} <span class="text-on-surface-variant/50">(~17)</span></span></div>
        </div>
      `
    }

    // Hypergeometric P(draw >= 1 card of a K-sized group in an n-card hand from
    // an N-card deck), computed via the complement (probability of drawing zero).
    function probAtLeastOne(N, K, n) {
      if (K <= 0) return 0
      if (N - K < n) return 1
      let pZero = 1
      for (let i = 0; i < n; i++) pZero *= (N - K - i) / (N - i)
      return 1 - pZero
    }

    function drawWidgetHtml() {
      const deck = currentDeckCards()
      const DECK_SIZE_ASSUMED = 40
      const HAND_SIZE = 7
      const groups = ['B', 'R', 'E', 'A', 'D', 'F']
      const labels = {
        B: i18n.breadBombLabel, R: i18n.breadRemovalLabel, E: i18n.breadEvasionLabel,
        A: i18n.breadAggroLabel, D: i18n.breadDiversityLabel, F: i18n.breadFillerLabel,
      }
      const rows = groups.map(g => {
        const count = deck.filter(c => c.bread === g).length
        if (count === 0) return ''
        const pct = Math.round(probAtLeastOne(DECK_SIZE_ASSUMED, count, HAND_SIZE) * 100)
        return `
          <div class="flex items-center justify-between gap-2 text-[11px]">
            <span title="${labels[g]}" class="inline-flex items-center gap-1.5 border rounded-full px-1.5 py-0.5 text-[9px] font-semibold ${breadPillClass(g)}">${g}</span>
            <span class="flex-1 text-on-surface-variant/70 truncate">${labels[g]} <span class="text-on-surface-variant/40">(${count})</span></span>
            <span class="font-semibold text-on-surface">${pct}%</span>
          </div>
        `
      }).filter(Boolean).join('')
      return rows || `<p class="text-[10px] text-on-surface-variant/50">—</p>`
    }

