    // ---- Hover-to-enlarge card preview (pointer devices with real hover only —
    // avoids fighting with touch dragging on tablets) ----
    const HOVER_TARGETS = '.canvas-card, .card-item'
    if (window.matchMedia('(hover: hover)').matches) {
      const hoverPreview = document.createElement('div')
      hoverPreview.id = 'sealed-hover-preview'
      hoverPreview.className = 'fixed z-[999] pointer-events-none hidden rounded-xl overflow-hidden shadow-2xl border border-white/20'
      hoverPreview.style.width = '260px'
      document.body.appendChild(hoverPreview)

      document.addEventListener('mouseover', e => {
        const target = e.target.closest(HOVER_TARGETS)
        if (!target) return
        const card = cardsByOracleId[target.dataset.oracleId]
        if (!card || !card.imageUrl) return
        hoverPreview.innerHTML = `<img src="${card.imageUrl}" alt="${card.name}" class="w-full h-auto block" />`
        hoverPreview.classList.remove('hidden')
      })

      document.addEventListener('mousemove', e => {
        if (hoverPreview.classList.contains('hidden')) return
        const margin = 20
        const previewW = 260
        const previewH = 360
        let x = e.clientX + margin
        let y = Math.min(e.clientY - previewH / 2, window.innerHeight - previewH - margin)
        y = Math.max(y, margin)
        if (x + previewW > window.innerWidth - margin) x = e.clientX - previewW - margin
        hoverPreview.style.left = x + 'px'
        hoverPreview.style.top = y + 'px'
      })

      document.addEventListener('mouseout', e => {
        const from = e.target.closest(HOVER_TARGETS)
        if (!from) return
        const to = e.relatedTarget && e.relatedTarget.closest ? e.relatedTarget.closest(HOVER_TARGETS) : null
        if (to === from) return
        hoverPreview.classList.add('hidden')
      })

      document.addEventListener('pointerdown', e => {
        if (e.target.closest(HOVER_TARGETS)) hoverPreview.classList.add('hidden')
      })
    }

    // ---- View transform (ported from DeckView.tsx: s2c / zoomAt / applyT) ----
    function s2c(sx, sy) {
      const r = viewport.getBoundingClientRect()
      return { x: (sx - r.left - view.tx) / view.sc, y: (sy - r.top - view.ty) / view.sc }
    }

    function applyT() {
      canvas.style.transform = `translate3d(${view.tx}px,${view.ty}px,0) scale(${view.sc})`
      zoomLabel.textContent = Math.round(view.sc * 100) + '%'
    }

    function zoomAt(cx, cy, factor) {
      const ns = Math.min(MAX_SCALE, Math.max(MIN_SCALE, view.sc * factor))
      const ratio = ns / view.sc
      view.tx = cx - (cx - view.tx) * ratio
      view.ty = cy - (cy - view.ty) * ratio
      view.sc = ns
      applyT()
      persistCurrentState()
    }

    viewport.addEventListener('wheel', e => {
      e.preventDefault()
      const r = viewport.getBoundingClientRect()
      zoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? ZOOM_IN_FACTOR : ZOOM_OUT_FACTOR)
    }, { passive: false })

    // ---- Pan (single pointer drag on empty canvas) + pinch-zoom (two pointers) ----
    // Pointer Events unify mouse/touch/pen, so this drives both desktop dragging
    // and tablet finger panning/pinching without a physical keyboard (no Space key).
    const activePointers = new Map() // pointerId -> { x, y }
    let pinchStartDist = null
    let pinchStartScale = null
    let pinchAnchor = null // canvas-space point pinch is zooming around

    function pointerDist(a, b) {
      return Math.hypot(a.x - b.x, a.y - b.y)
    }
    function pointerMid(a, b) {
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }
    }

    viewport.addEventListener('pointerdown', e => {
      if (e.target.closest('.canvas-card, .canvas-note, .canvas-widget')) return
      viewport.setPointerCapture(e.pointerId)
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY })

      if (activePointers.size === 1) {
        panState = { startX: e.clientX, startY: e.clientY, tx0: view.tx, ty0: view.ty }
        viewport.style.cursor = 'grabbing'
      } else if (activePointers.size === 2) {
        panState = null
        const pts = Array.from(activePointers.values())
        pinchStartDist = pointerDist(pts[0], pts[1])
        pinchStartScale = view.sc
        const r = viewport.getBoundingClientRect()
        const mid = pointerMid(pts[0], pts[1])
        pinchAnchor = { x: mid.x - r.left, y: mid.y - r.top }
      }
    })

    viewport.addEventListener('pointermove', e => {
      if (!activePointers.has(e.pointerId)) return
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY })

      if (activePointers.size >= 2 && pinchStartDist) {
        const pts = Array.from(activePointers.values())
        const dist = pointerDist(pts[0], pts[1])
        const ns = Math.min(MAX_SCALE, Math.max(MIN_SCALE, pinchStartScale * (dist / pinchStartDist)))
        const ratio = ns / view.sc
        view.tx = pinchAnchor.x - (pinchAnchor.x - view.tx) * ratio
        view.ty = pinchAnchor.y - (pinchAnchor.y - view.ty) * ratio
        view.sc = ns
        applyT()
        return
      }

      if (panState) {
        view.tx = panState.tx0 + (e.clientX - panState.startX)
        view.ty = panState.ty0 + (e.clientY - panState.startY)
        applyT()
      }
    })

    function endViewportPointer(e) {
      activePointers.delete(e.pointerId)
      if (activePointers.size < 2) pinchStartDist = null

      if (activePointers.size === 0) {
        if (panState) {
          panState = null
          viewport.style.cursor = ''
          persistCurrentState()
        }
      } else if (activePointers.size === 1) {
        // One finger lifted mid-pinch — resume panning with the remaining finger.
        const [remaining] = activePointers.values()
        panState = { startX: remaining.x, startY: remaining.y, tx0: view.tx, ty0: view.ty }
      }
    }
    viewport.addEventListener('pointerup', endViewportPointer)
    viewport.addEventListener('pointercancel', endViewportPointer)

    resetViewBtn.addEventListener('click', () => {
      view = { ...DEFAULT_VIEW }
      applyT()
      persistCurrentState()
    })

    // ---- Multi-select: bulk move to deck / sideboard ----
    let selectMode = false
    let selectedIds = new Set()

