    async function loadSetPool(code) {
      if (poolDataCache[code]) return poolDataCache[code]
      const res = await fetch(`/pool-data/${code}.json`)
      const data = await res.json()
      poolDataCache[code] = data
      return data
    }

    async function switchToSet(code) {
      currentSetCode = code
      const setData = await loadSetPool(code)
      cardsByOracleId = buildCardsByOracleId(setData)
      const stored = loadState(code)
      if (stored) {
        renderState(stored)
