      } else {
        clearBoard()
        view = { ...DEFAULT_VIEW }
        applyT()
        canvasEmptyMsg.classList.remove('hidden')
        updateDrawerEmptyState()
        updateSideboardEmptyState()
        updateStats()
        showSetupStage()
      }
    }

    async function generateAndRender() {
      const code = setSelect.value
      const setData = await loadSetPool(code)
      const packCount = Math.max(1, Math.min(6, Number(packCountInput.value) || 6))
      const poolIds = generatePoolIds(setData, packCount)
      view = { ...DEFAULT_VIEW }
      autoBuildSummary.textContent = ''
      renderState({ drawer: poolIds, sideboard: [], canvas: [], view })
      persistCurrentState()
      showBoardStage()
      openDrawer()
    }

    // Picking a set from the setup screen must never silently jump back into a
    // saved board — that's the "← Set" flow's whole purpose (start a new pool),
    // and auto-resuming here made it look like there was no way to reach
    // Generate Pool once a set already had saved state. Resuming that saved
    // pool is still one click away via the Resume button.
    async function selectSetOnSetup(code) {
      currentSetCode = code
      const setData = await loadSetPool(code)
      cardsByOracleId = buildCardsByOracleId(setData)
      const stored = loadState(code)
      resumeBtn.classList.toggle('hidden', !stored)
      resumeHint.classList.toggle('hidden', !stored)
    }

    resumeBtn.addEventListener('click', () => {
      const stored = loadState(currentSetCode)
      if (!stored) return
      renderState(stored)
      showBoardStage()
    })

    generateBtn.addEventListener('click', generateAndRender)
    regenerateBtn.addEventListener('click', generateAndRender)
    setSelect.addEventListener('change', () => selectSetOnSetup(setSelect.value))

    // ---- Auto-build: color pair + curve fill + Quadrant Theory tagging ----
    // Quadrant rows loosely follow the classic Develop/Parity/Ahead/Behind
    // split (BREAD pick-order + Quadrant Theory + CABS curve weighting), using
    // keywords/oracle text/power-toughness fetched live from Scryfall since the
    // local pool data doesn't carry that detail.
    const DEVELOP_KEYWORDS = new Set(['first strike', 'flash'])
    const AHEAD_KEYWORDS = new Set(['flying', 'haste', 'trample', 'menace', 'double strike'])
    const BEHIND_KEYWORDS = new Set(['deathtouch', 'reach', 'lifelink', 'defender'])
    const PARITY_KEYWORDS = new Set(['vigilance'])
    const BEHIND_TEXT = /destroy target creature|exile target creature|destroy all creatures|-\d+\/-\d+ to each|deals? \d+ damage to each creature|gains? \d+ life|prevent all combat damage/i
    const PARITY_TEXT = /draw a card/i
    const DEVELOP_TEXT = /create an? .*token|when .* enters the battlefield/i
    const AHEAD_TEXT = /can't be blocked|deals? \d+ damage to (target player|each opponent|any target)/i
    const COLORS = ['W', 'U', 'B', 'R', 'G']
    const DECK_SIZE = 23
    const CURVE_TARGETS = [[1, 2], [2, 6], [3, 5], [4, 4], [5, 3], [6, 2], [7, 1]]

    async function fetchScryfallDetails(cards) {
      const missing = cards.filter(c => c.scryfallId && !scryfallDetailsCache[c.scryfallId])
      for (let i = 0; i < missing.length; i += 75) {
        const chunk = missing.slice(i, i + 75)
        try {
          const res = await fetch('https://api.scryfall.com/cards/collection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifiers: chunk.map(c => ({ id: c.scryfallId })) }),
          })
          const data = await res.json()
          for (const sc of data.data || []) scryfallDetailsCache[sc.id] = sc
        } catch (err) {
          console.error('Scryfall lookup failed, quadrant tagging will fall back to Parity', err)
        }
      }
    }

    function scryfallFace(sc) {
      if (!sc) return {}
      if (sc.oracle_text || sc.power) return sc
      if (sc.card_faces && sc.card_faces[0]) return sc.card_faces[0]
      return sc
    }

    function classifyQuadrant(card) {
      const sc = scryfallDetailsCache[card.scryfallId]
      const keywords = (sc?.keywords || []).map(k => k.toLowerCase())
      for (const kw of keywords) {
        if (DEVELOP_KEYWORDS.has(kw)) return 'Develop'
        if (AHEAD_KEYWORDS.has(kw)) return 'Ahead'
        if (BEHIND_KEYWORDS.has(kw)) return 'Behind'
        if (PARITY_KEYWORDS.has(kw)) return 'Parity'
      }
      const text = scryfallFace(sc).oracle_text || ''
      if (BEHIND_TEXT.test(text)) return 'Behind'
      if (PARITY_TEXT.test(text)) return 'Parity'
      if (DEVELOP_TEXT.test(text)) return 'Develop'
      if (AHEAD_TEXT.test(text)) return 'Ahead'
      const power = Number(scryfallFace(sc).power)
      const toughness = Number(scryfallFace(sc).toughness)
      if (Number.isFinite(power) && Number.isFinite(toughness)) {
        if (toughness > power) return 'Behind'
        if (power > toughness) return 'Develop'
      }
      return 'Parity'
    }

    // Playables-per-color-pair scan, roughly mirroring the framework's Sheet 1/2
    // tallies: for every 2-color combo, sum the power_score of its best ~23 fits
    // (mono cards of either color, colorless, and exact-pair gold cards). Returns
    // every combo ranked best-first so autoBuildDeck can offer a few options.
    function rankColorPairs(cards) {
      const results = []
      for (let i = 0; i < COLORS.length; i++) {
        for (let j = i + 1; j < COLORS.length; j++) {
          const pair = [COLORS[i], COLORS[j]]
          const eligible = cards.filter(c => (c.colors || []).every(col => pair.includes(col)))
          const ranked = eligible.slice().sort((a, b) => b.power_score - a.power_score)
          const score = ranked.slice(0, DECK_SIZE).reduce((s, c) => s + c.power_score, 0)
          results.push({ pair, eligible, score })
        }
      }
      return results.sort((a, b) => b.score - a.score)
    }

    // Grades weigh three things, not just raw power:
    //  - Power (50%): average Limited Score, same as before.
    //  - BREAD coverage (30%): does the deck actually have the cards that win
    //    games — Bombs and Removal count fully, Evasion/Aggro count half —
    //    as a share of the deck, normalized against a ~35% target.
    //  - Synergy (20%): tribal density (creature types that repeat) plus
    //    keyword clustering (3+ cards sharing a keyword, e.g. a Flying shell)
    //    from the Scryfall data already fetched for quadrant tagging.
    const BREAD_COVERAGE_TARGET = 0.55

    function coverageScoreFor(deckCards) {
      if (deckCards.length === 0) return 0
      const weight = { B: 1, R: 1, E: 0.5, A: 0.5, D: 0, F: 0 }
      const weighted = deckCards.reduce((s, c) => s + (weight[c.bread] || 0), 0)
      return Math.min(1, weighted / deckCards.length / BREAD_COVERAGE_TARGET)
    }

    function synergyScoreFor(deckCards) {
      if (deckCards.length === 0) return 0
      const subtypeCounts = {}
      deckCards.forEach(c => {
        if (!c.typeLine || !c.typeLine.includes('Creature')) return
        const subtypes = c.typeLine.split('—')[1]
        if (!subtypes) return
        subtypes.trim().split(/\s+/).forEach(t => { subtypeCounts[t] = (subtypeCounts[t] || 0) + 1 })
      })
      const tribalWeight = Object.values(subtypeCounts).filter(n => n >= 2).reduce((s, n) => s + n, 0)

      const keywordCounts = {}
      deckCards.forEach(c => {
        const sc = scryfallDetailsCache[c.scryfallId]
        ;(sc?.keywords || []).forEach(k => { keywordCounts[k] = (keywordCounts[k] || 0) + 1 })
      })
      const keywordWeight = Object.values(keywordCounts).filter(n => n >= 3).reduce((s, n) => s + n, 0)

      return Math.min(1, (tribalWeight + keywordWeight * 0.5) / (deckCards.length * 0.6))
    }

    function compositeScoreFor(deckCards) {
      const avg = deckCards.length ? deckCards.reduce((s, c) => s + c.power_score, 0) / deckCards.length : 0
      const power = avg / 5
      const coverage = coverageScoreFor(deckCards)
      const synergy = synergyScoreFor(deckCards)
      const composite = power * 0.5 + coverage * 0.3 + synergy * 0.2
      return { avg, power, coverage, synergy, composite }
    }

    function gradeFor(compositeScore) {
      if (compositeScore >= 0.72) return 'A'
      if (compositeScore >= 0.58) return 'B'
      if (compositeScore >= 0.44) return 'C'
      if (compositeScore >= 0.30) return 'D'
      return 'F'
    }

    function tallyQuadrants(deckCards) {
      const tally = { Develop: 0, Parity: 0, Ahead: 0, Behind: 0 }
      deckCards.forEach(card => { tally[classifyQuadrant(card)]++ })
      return tally
    }

    // CABS-weighted curve fill: hit the 2s/3s targets first with the best card
    // available at each CMC, then top off with the highest remaining scores.
    function pickDeckCards(eligible) {
      const byCmc = {}
      for (const c of eligible) {
        const bucket = Math.min(Math.max(Math.round(c.cmc), 1), 7)
        ;(byCmc[bucket] = byCmc[bucket] || []).push(c)
      }
      for (const b in byCmc) byCmc[b].sort((a, b2) => b2.power_score - a.power_score)

      const picked = []
      const pickedIds = new Set()
      for (const [bucket, need] of CURVE_TARGETS) {
        const available = byCmc[bucket] || []
        for (let k = 0; k < need && k < available.length; k++) {
          picked.push(available[k])
          pickedIds.add(available[k].oracleId)
        }
      }
      const remaining = DECK_SIZE - picked.length
      if (remaining > 0) {
        const rest = eligible
          .filter(c => !pickedIds.has(c.oracleId))
          .sort((a, b) => b.power_score - a.power_score)
          .slice(0, remaining)
        picked.push(...rest)
      }
      return picked
    }

    const GRADE_CLASS = {
      A: 'bg-emerald-500 text-white border-emerald-200/60',
      B: 'bg-sky-500 text-white border-sky-200/60',
      C: 'bg-amber-500 text-white border-amber-200/60',
      D: 'bg-orange-500 text-white border-orange-200/60',
      F: 'bg-red-500 text-white border-red-200/60',
    }
    const QUADRANT_DOT_CLASS = {
      Develop: 'bg-emerald-400',
      Parity: 'bg-sky-400',
      Ahead: 'bg-orange-400',
      Behind: 'bg-primary',
    }

    let autoBuildCandidates = []
    let autoBuildPoolSnapshot = []
    let autoBuildHasExistingDeck = false

    // Diff view only kicks in above this match threshold — below it the two
    // decks are different enough that a swap-list stops being a useful nudge.
    const AUTOBUILD_DIFF_THRESHOLD = 0.8

    function autoBuildOptionHtml(candidate, index, confirmingIndex) {
      const colorIcons = candidate.pair.map(c => `<i class="ms ms-${c.toLowerCase()} ms-cost"></i>`).join(' ')
      const quadrantSummary = ['Develop', 'Parity', 'Ahead', 'Behind'].map(q => `
        <span title="${QUADRANT_NAME[q]}" class="inline-flex items-center gap-1">
          <span class="w-2 h-2 rounded-full ${QUADRANT_DOT_CLASS[q]}"></span>${QUADRANT_LETTER[q]} ${candidate.quadrants[q] || 0}
        </span>
      `).join('')

      const similarityHtml = candidate.similarity !== null
        ? `<div>${i18n.autoBuildSimilarityLabel}: <span class="text-on-surface font-semibold">${Math.round(candidate.similarity * 100)}%</span></div>`
        : ''

      const breakdownHtml = `
        <div class="flex flex-col gap-1 text-[10px]">
          ${[
            [i18n.autoBuildPowerLabel, candidate.power, 'bg-primary'],
            [i18n.autoBuildCoverageLabel, candidate.coverage, 'bg-sky-400'],
            [i18n.autoBuildSynergyLabel, candidate.synergy, 'bg-emerald-400'],
          ].map(([label, value, barClass]) => `
            <div class="flex items-center gap-2">
              <span class="w-14 text-on-surface-variant/60 flex-shrink-0">${label}</span>
              <span class="flex-1 h-1.5 rounded-full bg-white/10 overflow-hidden">
                <span class="block h-full ${barClass}" style="width:${Math.round(Math.min(1, value) * 100)}%"></span>
              </span>
              <span class="w-8 text-right font-semibold text-on-surface flex-shrink-0">${Math.round(Math.min(1, value) * 100)}%</span>
            </div>
          `).join('')}
        </div>
      `

      const showDiff = candidate.similarity !== null
        && candidate.similarity >= AUTOBUILD_DIFF_THRESHOLD
        && (candidate.toRemove.length > 0 || candidate.toAdd.length > 0)
      const diffHtml = showDiff ? `
        <div class="rounded-lg bg-black/20 border border-white/10 p-2 text-[10px] flex flex-col gap-1">
          ${candidate.toRemove.length ? `<div><span class="text-red-300 font-semibold">${i18n.autoBuildSwapOutLabel}:</span> <span class="text-on-surface-variant">${candidate.toRemove.map(c => c.name).join(', ')}</span></div>` : ''}
          ${candidate.toAdd.length ? `<div><span class="text-emerald-300 font-semibold">${i18n.autoBuildSwapInLabel}:</span> <span class="text-on-surface-variant">${candidate.toAdd.map(c => c.name).join(', ')}</span></div>` : ''}
        </div>
      ` : ''

      const actionHtml = index === confirmingIndex ? `
        <p class="text-[10px] text-red-300">${i18n.autoBuildConfirmWarning}</p>
        <div class="flex gap-2">
          <button data-candidate-index="${index}" class="confirm-candidate-btn flex-1 px-3 py-1.5 rounded-lg bg-primary text-on-primary font-bold text-xs hover:bg-primary-container transition-colors">${i18n.autoBuildConfirmReplace}</button>
          <button class="cancel-candidate-btn px-3 py-1.5 rounded-lg border border-white/10 text-on-surface-variant text-xs font-semibold hover:text-on-surface transition-colors">${i18n.autoBuildCancel}</button>
        </div>
      ` : `
        <button data-candidate-index="${index}" class="use-candidate-btn px-3 py-1.5 rounded-lg bg-primary text-on-primary font-bold text-xs hover:bg-primary-container transition-colors">${i18n.autoBuildUseDeck}</button>
      `

      return `
        <div class="rounded-xl border border-white/10 bg-surface/60 p-4 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-2xl flex items-center gap-1">${colorIcons}</span>
            <span class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm border ${GRADE_CLASS[candidate.grade]}">${candidate.grade}</span>
          </div>
          <div class="text-xs text-on-surface-variant/70 flex flex-col gap-0.5">
            <div>${i18n.autoBuildAvgScoreLabel}: <span class="text-on-surface font-semibold">${candidate.avg.toFixed(2)}</span></div>
            <div>${i18n.autoBuildDeckSizeLabel}: <span class="text-on-surface font-semibold">${candidate.deckCards.length}</span></div>
            ${similarityHtml}
          </div>
          ${breakdownHtml}
          <div class="flex flex-wrap gap-3 text-[10px] text-on-surface-variant/70">${quadrantSummary}</div>
          ${diffHtml}
          <div class="mt-1 flex flex-col gap-1.5">${actionHtml}</div>
        </div>
      `
    }

    function renderAutoBuildOptions(confirmingIndex) {
      autoBuildOptions.innerHTML = autoBuildCandidates
        .map((c, i) => autoBuildOptionHtml(c, i, confirmingIndex))
        .join('')
    }

    function closeAutoBuildModal() {
      autoBuildModal.classList.add('hidden')
    }

    function showAutoBuildModal(candidates, pool, hasExistingDeck) {
      autoBuildCandidates = candidates
      autoBuildPoolSnapshot = pool
      autoBuildHasExistingDeck = hasExistingDeck
      renderAutoBuildOptions(null)
      autoBuildModal.classList.remove('hidden')
    }

    // Delegated once — survives the innerHTML re-renders triggered by confirm/cancel.
    autoBuildOptions.addEventListener('click', e => {
      const useBtn = e.target.closest('.use-candidate-btn')
      const confirmBtn = e.target.closest('.confirm-candidate-btn')
      const cancelBtn = e.target.closest('.cancel-candidate-btn')

      if (useBtn) {
        const idx = Number(useBtn.dataset.candidateIndex)
        if (autoBuildHasExistingDeck) {
          renderAutoBuildOptions(idx)
        } else {
          applyAutoBuildCandidate(autoBuildCandidates[idx], autoBuildPoolSnapshot)
          closeAutoBuildModal()
        }
        return
      }
      if (confirmBtn) {
        const idx = Number(confirmBtn.dataset.candidateIndex)
        applyAutoBuildCandidate(autoBuildCandidates[idx], autoBuildPoolSnapshot)
        closeAutoBuildModal()
        return
      }
      if (cancelBtn) {
        renderAutoBuildOptions(null)
      }
    })

    autoBuildModalClose.addEventListener('click', closeAutoBuildModal)
    autoBuildModal.addEventListener('click', e => {
      if (e.target === autoBuildModal) closeAutoBuildModal()
    })

    function applyAutoBuildCandidate(candidate, pool) {
      const deckIds = new Set(candidate.deckCards.map(c => c.oracleId))
      const leftovers = pool.filter(c => !deckIds.has(c.oracleId))

      clearBoard()
      view = { ...DEFAULT_VIEW }
      applyT()

      const COLUMN_GAP = 24
      const ROW_STEP = 42
      const BASE_X = 40
      const BASE_Y = 30
      const columnCounts = {}
      candidate.deckCards
        .slice()
        .sort((a, b) => a.cmc - b.cmc || b.power_score - a.power_score)
        .forEach(card => {
          const col = Math.min(Math.max(Math.round(card.cmc), 0), 7)
          const idx = columnCounts[col] || 0
          columnCounts[col] = idx + 1
          const x = BASE_X + col * (TILE_WIDTH + COLUMN_GAP)
          const y = BASE_Y + idx * ROW_STEP
          const quadrant = classifyQuadrant(card)
          canvas.appendChild(makeCanvasCardEl(card, x, y, true, quadrant))
        })

      leftovers.forEach(card => appendListRow(sideboardList, card))

      canvasEmptyMsg.classList.toggle('hidden', candidate.deckCards.length > 0)
      updateDrawerEmptyState()
      updateSideboardEmptyState()
      updateStats()
      persistCurrentState()
      autoBuildSummary.textContent = `${candidate.pair.join('')} · ${candidate.grade} · ${candidate.deckCards.length}`
    }

    const AUTOBUILD_OPTION_COUNT = 4

    async function autoBuildDeck() {
      autoBuildBtn.disabled = true
      autoBuildBtn.textContent = i18n.autoBuildBuilding
      try {
        const allIds = new Set([
          ...Array.from(drawerList.children).map(el => el.dataset.oracleId),
          ...Array.from(canvas.querySelectorAll('.canvas-card')).map(el => el.dataset.oracleId),
          ...Array.from(sideboardList.children).map(el => el.dataset.oracleId),
        ])
        const pool = Array.from(allIds).map(id => cardsByOracleId[id]).filter(Boolean)
        if (pool.length === 0) return

        await fetchScryfallDetails(pool)

        // Snapshot the deck the user has already marked, so each option can be
        // graded on how close it is to what you built — and, above the diff
        // threshold, show exactly which cards would swap.
        const currentDeckCards = Array.from(canvas.querySelectorAll('.canvas-card[data-in-deck="1"]'))
          .map(el => cardsByOracleId[el.dataset.oracleId])
          .filter(Boolean)
        const currentDeckIds = new Set(currentDeckCards.map(c => c.oracleId))
        const hasExistingDeck = currentDeckCards.length > 0

        const candidates = rankColorPairs(pool)
          .filter(c => c.eligible.length > 0)
          .slice(0, AUTOBUILD_OPTION_COUNT)
          .map(({ pair, eligible }) => {
            const deckCards = pickDeckCards(eligible)
            const { avg, power, coverage, synergy, composite } = compositeScoreFor(deckCards)
            const candidateIds = new Set(deckCards.map(c => c.oracleId))

            let similarity = null
            let toRemove = []
            let toAdd = []
            if (hasExistingDeck) {
              const overlap = deckCards.filter(c => currentDeckIds.has(c.oracleId)).length
              const unionSize = new Set([...currentDeckIds, ...candidateIds]).size
              similarity = unionSize > 0 ? overlap / unionSize : 0
              toRemove = currentDeckCards.filter(c => !candidateIds.has(c.oracleId))
              toAdd = deckCards.filter(c => !currentDeckIds.has(c.oracleId))
            }

            return {
              pair, deckCards, avg, power, coverage, synergy, composite,
              grade: gradeFor(composite),
              quadrants: tallyQuadrants(deckCards),
              similarity, toRemove, toAdd,
            }
          })

        showAutoBuildModal(candidates, pool, hasExistingDeck)
      } finally {
        autoBuildBtn.disabled = false
        autoBuildBtn.textContent = i18n.autoBuildLabel
      }
    }

    autoBuildBtn.addEventListener('click', autoBuildDeck)

    // ---- Export to MTG Arena ----
    // Deck = cards marked "In deck" on canvas. Sideboard = everything else in the
    // current pool (Sideboard panel + unmarked canvas cards + Pool drawer), so the
    // rest of the pool is still available in Arena's builder for adjustments.
    function arenaLine(card) {
      const sc = scryfallDetailsCache[card.scryfallId]
      if (sc && sc.set && sc.collector_number) {
        return `1 ${sc.name} (${sc.set.toUpperCase()}) ${sc.collector_number}`
      }
      return `1 ${card.name}`
    }

    async function buildArenaExportText() {
      const canvasCards = Array.from(canvas.querySelectorAll('.canvas-card'))
      const deckCards = canvasCards
        .filter(el => el.dataset.inDeck === '1')
        .map(el => cardsByOracleId[el.dataset.oracleId])
        .filter(Boolean)
      const sideboardCards = [
        ...canvasCards.filter(el => el.dataset.inDeck !== '1').map(el => cardsByOracleId[el.dataset.oracleId]),
        ...Array.from(sideboardList.children).map(el => cardsByOracleId[el.dataset.oracleId]),
        ...Array.from(drawerList.children).map(el => cardsByOracleId[el.dataset.oracleId]),
      ].filter(Boolean)

      await fetchScryfallDetails([...deckCards, ...sideboardCards])

      const lines = ['Deck', ...deckCards.map(arenaLine)]
      if (sideboardCards.length) {
        lines.push('', 'Sideboard', ...sideboardCards.map(arenaLine))
      }
      return lines.join('\n')
    }

    async function openExportModal() {
      exportBtn.disabled = true
      try {
        exportTextarea.value = await buildArenaExportText()
        exportModal.classList.remove('hidden')
      } finally {
        exportBtn.disabled = false
      }
    }

    exportBtn.addEventListener('click', openExportModal)
    exportModalClose.addEventListener('click', () => exportModal.classList.add('hidden'))
    exportModal.addEventListener('click', e => {
      if (e.target === exportModal) exportModal.classList.add('hidden')
    })
    exportCopyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(exportTextarea.value)
      } catch {
        exportTextarea.select()
        document.execCommand('copy')
      }
      exportCopyBtn.textContent = i18n.exportCopied
      setTimeout(() => { exportCopyBtn.textContent = i18n.exportCopyButton }, 1500)
    })

    async function init() {
      applyT()
      await loadManifest()
      if (setSelect.options.length > 0) {
        await switchToSet(setSelect.value)
      }
    }

    init()
  </script>
</BaseLayout>
