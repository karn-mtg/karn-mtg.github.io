    const QUADRANT_LETTER = { Develop: 'D', Parity: 'P', Ahead: 'A', Behind: 'B' }
    const QUADRANT_NAME = {
      Develop: i18n.quadrantDevelopLabel,
      Parity: i18n.quadrantParityLabel,
