    let cardsByOracleId = {}
    let scryfallDetailsCache = {}
    let view = { ...DEFAULT_VIEW }
    let panState = null // { startX, startY, tx0, ty0 } for a single-pointer pan

    // ---- Stage switching ----
    function showSetupStage() {
