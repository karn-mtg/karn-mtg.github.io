    // ---- In-canvas dragging (Pointer Events so it works for mouse, touch, and pen alike) ----
    function makeCanvasCardDraggable(el) {
      makeCanvasItemDraggable(el, '.mark-deck-btn, .to-sideboard-btn', { selectable: true })
    }

    // Shared by MTG cards, sticky notes, and widgets — anything positioned
    // absolutely on the canvas. excludeSelector opts specific child controls
    // (buttons, editable text) out of starting a drag. selectable elements
    // (cards) toggle selection on tap instead of dragging while Select mode
    // is active, so touch users don't need a modifier key to multi-select.
    function makeCanvasItemDraggable(el, excludeSelector, opts = {}) {
      let dragOffset = null
      let dragPointerId = null

      el.addEventListener('pointerdown', e => {
        if (excludeSelector && e.target.closest(excludeSelector)) return
        if (opts.selectable && selectMode) {
          e.preventDefault()
          e.stopPropagation()
          setCardSelected(el, !el.classList.contains('selected-card'))
          return
        }
        e.preventDefault()
        e.stopPropagation()
        dragPointerId = e.pointerId
        el.setPointerCapture(dragPointerId)
        const left = parseFloat(el.style.left) || 0
        const top = parseFloat(el.style.top) || 0
        const cp = s2c(e.clientX, e.clientY)
        dragOffset = { ox: cp.x - left, oy: cp.y - top }
        el.style.cursor = 'grabbing'
        el.style.zIndex = '50'
      })

      el.addEventListener('pointermove', e => {
        if (!dragOffset || e.pointerId !== dragPointerId) return
        const p = s2c(e.clientX, e.clientY)
        el.style.left = (p.x - dragOffset.ox) + 'px'
        el.style.top = (p.y - dragOffset.oy) + 'px'
      })

      function endDrag(e) {
        if (e.pointerId !== dragPointerId) return
        dragOffset = null
        dragPointerId = null
        el.style.cursor = 'grab'
        el.style.zIndex = ''
        persistCurrentState()
      }
      el.addEventListener('pointerup', endDrag)
      el.addEventListener('pointercancel', endDrag)
    }

    // ---- Drawer / sideboard <-> canvas drag & drop ----
    function removeListRow(oracleId) {
      const row = drawerList.querySelector(`[data-oracle-id="${CSS.escape(oracleId)}"]`)
        || sideboardList.querySelector(`[data-oracle-id="${CSS.escape(oracleId)}"]`)
      if (row) row.remove()
    }

    viewport.addEventListener('dragover', e => {
      e.preventDefault()
      e.dataTransfer.dropEffect = 'move'
    })
    viewport.addEventListener('drop', e => {
      e.preventDefault()
      const oracleId = e.dataTransfer.getData('text/plain')
      if (!oracleId) return
      const card = cardsByOracleId[oracleId]
      if (!card) return
      const p = s2c(e.clientX, e.clientY)
      const x = p.x - TILE_WIDTH / 2
      const y = p.y - TILE_HEIGHT / 2
      canvas.appendChild(makeCanvasCardEl(card, x, y, false))

      removeListRow(oracleId)

      canvasEmptyMsg.classList.add('hidden')
      updateDrawerEmptyState()
      updateSideboardEmptyState()
      updateStats()
      persistCurrentState()
    })

    // Dragging a Pool row onto the Sideboard panel (or vice versa) moves it between lists.
    function wireListDropTarget(panelEl, targetList) {
      panelEl.addEventListener('dragover', e => {
        e.preventDefault()
        e.dataTransfer.dropEffect = 'move'
      })
      panelEl.addEventListener('drop', e => {
        e.preventDefault()
        const oracleId = e.dataTransfer.getData('text/plain')
        if (!oracleId) return
        const card = cardsByOracleId[oracleId]
        if (!card) return
        if (targetList.querySelector(`[data-oracle-id="${CSS.escape(oracleId)}"]`)) return
        removeListRow(oracleId)
        appendListRow(targetList, card)
        updateDrawerEmptyState()
        updateSideboardEmptyState()
        updateStats()
        persistCurrentState()
      })
    }
    wireListDropTarget(drawer, drawerList, updateDrawerEmptyState)
    wireListDropTarget(sideboard, sideboardList, updateSideboardEmptyState)

    // ---- Stats / persistence ----
    function updateDrawerEmptyState() {
      const count = drawerList.children.length
      drawerCountEl.textContent = String(count)
      drawerEmpty.classList.toggle('hidden', count > 0)
    }

    function updateSideboardEmptyState() {
      const count = sideboardList.children.length
      sideboardCountEl.textContent = String(count)
      sideboardEmpty.classList.toggle('hidden', count > 0)
    }

    function updateStats() {
      const poolCount = drawerList.children.length
      const canvasCards = canvas.querySelectorAll('.canvas-card')
      const placedCount = canvasCards.length
      const deckCount = Array.from(canvasCards).filter(el => el.dataset.inDeck === '1').length
      const sideboardCount = sideboardList.children.length
      document.querySelector('#sealed-pool-count-tile .text-lg').textContent = String(poolCount)
      document.querySelector('#sealed-placed-count-tile .text-lg').textContent = String(placedCount)
      document.querySelector('#sealed-deck-count-tile .text-lg').textContent = String(deckCount)
      document.querySelector('#sealed-sideboard-count-tile .text-lg').textContent = String(sideboardCount)
      refreshCanvasWidgets()
    }

    function storageKey(setCode) {
      return `karn-sealed-${setCode}`
    }

    function persistCurrentState() {
      if (!currentSetCode) return
      const drawerIds = Array.from(drawerList.children).map(el => el.dataset.oracleId)
      const sideboardIds = Array.from(sideboardList.children).map(el => el.dataset.oracleId)
      const canvasCards = Array.from(canvas.querySelectorAll('.canvas-card')).map(el => ({
        oracleId: el.dataset.oracleId,
        x: parseFloat(el.style.left) || 0,
        y: parseFloat(el.style.top) || 0,
        inDeck: el.dataset.inDeck === '1',
        quadrant: el.dataset.quadrant || null,
      }))
      const notes = Array.from(canvas.querySelectorAll('.canvas-note')).map(el => ({
        id: el.dataset.noteId,
        x: parseFloat(el.style.left) || 0,
        y: parseFloat(el.style.top) || 0,
        text: el.querySelector('.note-text').textContent,
      }))
      const widgets = Array.from(canvas.querySelectorAll('.canvas-widget')).map(el => ({
        id: el.dataset.widgetId,
        x: parseFloat(el.style.left) || 0,
        y: parseFloat(el.style.top) || 0,
        kind: el.dataset.widgetKind,
      }))
      localStorage.setItem(storageKey(currentSetCode), JSON.stringify({ drawer: drawerIds, sideboard: sideboardIds, canvas: canvasCards, notes, widgets, view }))
    }

    function loadState(setCode) {
      const raw = localStorage.getItem(storageKey(setCode))
      if (!raw) return null
      let parsed
      try { parsed = JSON.parse(raw) } catch { return null }
      // Guard against the old grid-based schema ({pool, deck}) left over in
      // localStorage from a previous version of this page -- treat as absent
      // rather than crashing renderState.
      if (!parsed || !Array.isArray(parsed.drawer) || !Array.isArray(parsed.canvas)) return null
      if (!Array.isArray(parsed.sideboard)) parsed.sideboard = []
      if (!Array.isArray(parsed.notes)) parsed.notes = []
      if (!Array.isArray(parsed.widgets)) parsed.widgets = []
      return parsed
    }

    function clearBoard() {
      drawerList.innerHTML = ''
      sideboardList.innerHTML = ''
      canvas.querySelectorAll('.canvas-card, .canvas-note, .canvas-widget').forEach(el => el.remove())
      selectedIds.clear()
      updateSelectionBar()
    }

    function renderState(state) {
      clearBoard()
      state.drawer.forEach(id => {
        const card = cardsByOracleId[id]
        if (card) appendListRow(drawerList, card)
      })
      state.sideboard.forEach(id => {
        const card = cardsByOracleId[id]
        if (card) appendListRow(sideboardList, card)
      })
      state.canvas.forEach(({ oracleId, x, y, inDeck, quadrant }) => {
        const card = cardsByOracleId[oracleId]
        if (card) canvas.appendChild(makeCanvasCardEl(card, x, y, inDeck, quadrant))
      })
      ;(state.notes || []).forEach(({ id, x, y, text }) => {
        canvas.appendChild(makeStickyNoteEl(id, x, y, text))
      })
      ;(state.widgets || []).forEach(({ id, x, y, kind }) => {
        canvas.appendChild(makeWidgetEl(id, x, y, kind))
      })
      view = state.view ? { ...state.view } : { ...DEFAULT_VIEW }
      applyT()
      canvasEmptyMsg.classList.toggle('hidden', state.canvas.length > 0)
      updateDrawerEmptyState()
      updateSideboardEmptyState()
      updateStats()
    }

    async function loadManifest() {
      const res = await fetch('/pool-data/manifest.json')
