---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteNav from '../../components/SiteNav.astro'
import { t, blogBase } from '../../i18n'

const i18n = t('en')

const title = 'Flashcards — Karn Forge'
const description = 'An Anki-style trainer: drill B.R.E.A.D. card evaluation and Quadrant Theory on real cards from every scored set until the read is automatic.'

const breadArticleHref = `${blogBase('en')}/${i18n.breadArticleSlug}`
---

<BaseLayout title={title} description={description} lang="en">
  <div style="background-image: radial-gradient(circle, rgba(43,46,51,0.6) 1px, transparent 1px); background-size: 24px 24px; min-height: 100vh;">
    <SiteNav lang="en" />

    <main class="max-w-xl mx-auto pt-28 pb-16 px-4 sm:px-6">
      <!-- ============ DASHBOARD ============ -->
      <div id="fc-dashboard">
        <div class="text-center mb-6">
          <h1 class="text-3xl sm:text-4xl font-bold text-on-surface leading-tight mb-3">Sealed Flashcards</h1>
          <p class="text-on-surface-variant" id="fc-intro-text"></p>
          <p class="text-xs text-on-surface-variant/50 mt-3" id="fc-intro-sub"></p>
        </div>

        <div class="flex gap-2 mb-4" id="fc-mode-toggle">
          <button data-mode="bread" class="fc-mode-btn flex-1 px-3 py-2.5 rounded-xl text-sm font-bold border transition-colors">B.R.E.A.D.</button>
          <button data-mode="quadrant" class="fc-mode-btn flex-1 px-3 py-2.5 rounded-xl text-sm font-bold border transition-colors">Quadrant</button>
        </div>

        <div class="glass-panel rounded-2xl p-5 mb-4">
          <label class="flex flex-col gap-1.5 text-sm mb-4">
            <span class="text-xs uppercase tracking-widest text-on-surface-variant/60">Set</span>
            <select id="fc-set-select" class="bg-surface border border-white/10 rounded-lg px-3 py-2 text-on-surface text-sm w-full">
              <option value="ALL">Loading sets…</option>
            </select>
          </label>
          <button id="fc-start-btn" class="w-full px-5 py-3 rounded-xl bg-primary text-on-primary font-bold text-sm hover:bg-primary-container transition-colors disabled:opacity-40 disabled:cursor-wait" disabled>
            Loading card pool…
          </button>
        </div>

        <div class="grid grid-cols-4 gap-2 mb-4">
          <div class="glass-panel rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-primary" id="fc-stat-sessions">0</div>
            <div class="text-[10px] uppercase tracking-wide text-on-surface-variant/60">Sessions</div>
          </div>
          <div class="glass-panel rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-primary" id="fc-stat-streak">0</div>
            <div class="text-[10px] uppercase tracking-wide text-on-surface-variant/60">Streak</div>
          </div>
          <div class="glass-panel rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-primary" id="fc-stat-accuracy">–</div>
            <div class="text-[10px] uppercase tracking-wide text-on-surface-variant/60">Accuracy</div>
          </div>
          <div class="glass-panel rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-primary" id="fc-stat-mastered">0/0</div>
            <div class="text-[10px] uppercase tracking-wide text-on-surface-variant/60">Mastered</div>
          </div>
        </div>

        <div class="text-xs uppercase tracking-widest text-on-surface-variant/60 mb-2" id="fc-category-heading">By category</div>
        <div id="fc-category-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-2"></div>
      </div>

      <!-- ============ STUDY ============ -->
      <div id="fc-study" class="hidden">
        <div class="flex items-center justify-between mb-4">
          <button id="fc-back-btn" class="text-sm italic text-on-surface-variant hover:text-on-surface transition-colors">&lsaquo; Flashcards</button>
          <span id="fc-due-pill" class="text-xs text-on-surface-variant border border-white/10 rounded-full px-3 py-1"></span>
        </div>

        <div class="glass-panel rounded-2xl p-4" id="fc-card-panel"></div>
      </div>
    </main>
  </div>

  <script define:vars={{
    breadArticleHref,
    breadMeta: {
      B: { label: i18n.breadBombLabel, def: i18n.breadBombDef, badge: 'bg-primary/15 text-primary border-primary/30' },
      R: { label: i18n.breadRemovalLabel, def: i18n.breadRemovalDef, badge: 'bg-red-400/15 text-red-300 border-red-400/30' },
      E: { label: i18n.breadEvasionLabel, def: i18n.breadEvasionDef, badge: 'bg-sky-400/15 text-sky-300 border-sky-400/30' },
      A: { label: i18n.breadAggroLabel, def: i18n.breadAggroDef, badge: 'bg-orange-400/15 text-orange-300 border-orange-400/30' },
      D: { label: i18n.breadDiversityLabel, def: i18n.breadDiversityDef, badge: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30' },
      F: { label: i18n.breadFillerLabel, def: 'Replaceable role-players with a reasonable rate but no standout upside — the cards that round out a curve rather than win the game.', badge: 'bg-white/5 text-on-surface-variant/70 border-white/10' },
    },
    quadrantMeta: {
      Develop: { label: i18n.sealedQuadrantDevelopLabel, def: i18n.sealedQuadrantDevelopDesc, badge: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30' },
      Parity: { label: i18n.sealedQuadrantParityLabel, def: i18n.sealedQuadrantParityDesc, badge: 'bg-sky-400/15 text-sky-300 border-sky-400/30' },
      Ahead: { label: i18n.sealedQuadrantAheadLabel, def: i18n.sealedQuadrantAheadDesc, badge: 'bg-orange-400/15 text-orange-300 border-orange-400/30' },
      Behind: { label: i18n.sealedQuadrantBehindLabel, def: i18n.sealedQuadrantBehindDesc, badge: 'bg-primary/15 text-primary border-primary/30' },
    },
  }}>
    const BREAD_ORDER = ['B', 'R', 'E', 'A', 'D', 'F']
    const QUADRANT_ORDER = ['Develop', 'Parity', 'Ahead', 'Behind']
    const BOX_INTERVALS_MS = [0, 1 * 86400000, 3 * 86400000, 7 * 86400000, 14 * 86400000]
    const SESSION_KEY = 'karn-flashcards-sessions-v1'
    const MODE_KEY = 'karn-flashcards-mode-v1'

    // Ported verbatim from the Sealed Simulator's Auto-Build quadrant tagging
    // (src/pages/[...locale]/sealed/index.astro) so both features teach the
    // exact same Develop/Parity/Ahead/Behind read — pool-data doesn't carry
    // keywords/oracle text/power/toughness, so this fetches them live from
    // Scryfall's collection endpoint, same as Sealed already does.
    const DEVELOP_KEYWORDS = new Set(['first strike', 'flash'])
    const AHEAD_KEYWORDS = new Set(['flying', 'haste', 'trample', 'menace', 'double strike'])
    const BEHIND_KEYWORDS = new Set(['deathtouch', 'reach', 'lifelink', 'defender'])
    const PARITY_KEYWORDS = new Set(['vigilance'])
    const BEHIND_TEXT = /destroy target creature|exile target creature|destroy all creatures|-\d+\/-\d+ to each|deals? \d+ damage to each creature|gains? \d+ life|prevent all combat damage/i
    const PARITY_TEXT = /draw a card/i
    const DEVELOP_TEXT = /create an? .*token|when .* enters the battlefield/i
    const AHEAD_TEXT = /can't be blocked|deals? \d+ damage to (target player|each opponent|any target)/i

    let scryfallDetailsCache = {}

    async function fetchScryfallDetails(cards) {
      const missing = cards.filter(c => c.scryfallId && !scryfallDetailsCache[c.scryfallId])
      for (let i = 0; i < missing.length; i += 75) {
        const chunk = missing.slice(i, i + 75)
        try {
          const res = await fetch('https://api.scryfall.com/cards/collection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifiers: chunk.map(c => ({ id: c.scryfallId })) }),
          })
          const data = await res.json()
          for (const sc of data.data || []) scryfallDetailsCache[sc.id] = sc
        } catch (e) { /* quadrant tagging falls back to Parity for these cards */ }
      }
    }

    function scryfallFace(sc) {
      if (!sc) return {}
      if (sc.oracle_text || sc.power) return sc
      if (sc.card_faces && sc.card_faces[0]) return sc.card_faces[0]
      return sc
    }

    function classifyQuadrant(card) {
      const sc = scryfallDetailsCache[card.scryfallId]
      // Develop means "Turns 1-3 — curving out and applying early pressure"
      // (see i18n sealedQuadrantDevelopDesc), so it's gated to cheap cards —
      // otherwise a first-strike/flash keyword, an ETB/token clause, or just
      // power > toughness on an expensive card wrongly reads as Develop no
      // matter its actual mana value.
      const cmc = Number(sc?.cmc ?? card.cmc ?? 0)
      const isCheap = cmc <= 3
      const keywords = (sc?.keywords || []).map(k => k.toLowerCase())
      for (const kw of keywords) {
        if (isCheap && DEVELOP_KEYWORDS.has(kw)) return 'Develop'
        if (AHEAD_KEYWORDS.has(kw)) return 'Ahead'
        if (BEHIND_KEYWORDS.has(kw)) return 'Behind'
        if (PARITY_KEYWORDS.has(kw)) return 'Parity'
      }
      const text = scryfallFace(sc).oracle_text || ''
      if (BEHIND_TEXT.test(text)) return 'Behind'
      if (PARITY_TEXT.test(text)) return 'Parity'
      if (isCheap && DEVELOP_TEXT.test(text)) return 'Develop'
      if (AHEAD_TEXT.test(text)) return 'Ahead'
      const power = Number(scryfallFace(sc).power)
      const toughness = Number(scryfallFace(sc).toughness)
      if (Number.isFinite(power) && Number.isFinite(toughness)) {
        if (toughness > power) return 'Behind'
        if (isCheap && power > toughness) return 'Develop'
      }
      return 'Parity'
    }

    async function ensureQuadrantData(cards) {
      await fetchScryfallDetails(cards)
      cards.forEach(c => { if (!c.quadrant) c.quadrant = classifyQuadrant(c) })
    }

    const MODES = {
      bread: {
        order: BREAD_ORDER,
        meta: breadMeta,
        progressKey: 'karn-flashcards-progress-v1',
        question: "What's its B.R.E.A.D. category?",
        categoryHeading: 'By category',
        intro: 'Train your B.R.E.A.D. eye on real cards from every scored set — Anki-style spaced repetition, until the read is automatic.',
        introSub: `Power scores and B.R.E.A.D. tags are heuristic estimates from Karn's card scoring — <a href="${breadArticleHref}" class="text-primary hover:underline">read the B.R.E.A.D. explainer</a>.`,
        needsPrefetch: false,
        getCategory: c => c.bread,
      },
      quadrant: {
        order: QUADRANT_ORDER,
        meta: quadrantMeta,
        progressKey: 'karn-flashcards-quadrant-progress-v1',
        question: 'Which quadrant does it fit best?',
        categoryHeading: 'By quadrant',
        intro: 'Train Quadrant Theory on real cards — which part of the game a card actually wins: developing your board, grinding at parity, closing out a lead, or stabilizing from behind.',
        introSub: 'Quadrant tags are computed live the same way the Sealed Simulator\'s Auto-Build does — from card keywords, oracle text, and power/toughness.',
        needsPrefetch: true,
        getCategory: c => c.quadrant,
      },
    }

    let currentMode = 'bread'
    let manifest = []
    let poolCache = {}
    let progressByMode = { bread: {}, quadrant: {} }
    let sessionLog = { totalSessions: 0, streak: 0, lastSessionDay: null }
    let currentScopeCards = []
    let queue = []
    let current = null
    let picked = null
    let answered = false

    const dashboardEl = document.getElementById('fc-dashboard')
    const studyEl = document.getElementById('fc-study')
    const setSelect = document.getElementById('fc-set-select')
    const startBtn = document.getElementById('fc-start-btn')
    const backBtn = document.getElementById('fc-back-btn')
    const duePill = document.getElementById('fc-due-pill')
    const cardPanel = document.getElementById('fc-card-panel')
    const categoryGrid = document.getElementById('fc-category-grid')
    const categoryHeading = document.getElementById('fc-category-heading')
    const introText = document.getElementById('fc-intro-text')
    const introSub = document.getElementById('fc-intro-sub')
    const modeToggle = document.getElementById('fc-mode-toggle')

    function storageGet(key, fallback) {
      try {
        const raw = localStorage.getItem(key)
        return raw ? JSON.parse(raw) : fallback
      } catch (e) {
        return fallback
      }
    }
    function storageSet(key, value) {
      try {
        localStorage.setItem(key, JSON.stringify(value))
      } catch (e) { /* storage unavailable — progress just won't persist */ }
    }

    function cardKey(setCode, oracleId) {
      return `${setCode}:${oracleId}`
    }
    function getProgress(key) {
      const store = progressByMode[currentMode]
      if (!store[key]) store[key] = { box: 0, lastReviewed: null, seen: 0, correct: 0 }
      return store[key]
    }
    function isDue(key) {
      const p = progressByMode[currentMode][key]
      if (!p || !p.lastReviewed) return true
      return (Date.now() - p.lastReviewed) >= BOX_INTERVALS_MS[Math.min(p.box, 4)]
    }

    async function loadManifest() {
      const res = await fetch('/pool-data/manifest.json')
      manifest = await res.json()
      setSelect.innerHTML =
        `<option value="ALL">All Sets (Mixed)</option>` +
        manifest.map(s => `<option value="${s.code}">${s.name} (${s.code})</option>`).join('')
    }

    async function loadSetPool(code) {
      if (poolCache[code]) return poolCache[code]
      const res = await fetch(`/pool-data/${code}.json`)
      const data = await res.json()
      const cards = []
      for (const rarity of Object.keys(data.rarities)) {
        for (const c of data.rarities[rarity]) {
          if (!BREAD_ORDER.includes(c.bread) || !c.imageUrl || !c.scryfallId) continue
          cards.push({ ...c, rarity, setCode: data.set_code.toUpperCase(), setName: data.set_name, key: cardKey(data.set_code.toUpperCase(), c.oracleId) })
        }
      }
      poolCache[code] = cards
      return cards
    }

    async function loadScopeCards(scope) {
      if (scope === 'ALL') {
        const all = await Promise.all(manifest.map(s => loadSetPool(s.code)))
        return all.flat()
      }
      return loadSetPool(scope)
    }

    function scryfallSearchUrl(name) {
      return `https://scryfall.com/search?q=!${encodeURIComponent('"' + name + '"')}`
    }

    function manaCostIcons(manaCost) {
      const symbols = manaCost ? manaCost.match(/\{[^}]+\}/g) : null
      if (!symbols) return ''
      return symbols.map(sym => {
        const slug = sym.slice(1, -1).toLowerCase().replace(/\//g, '')
        return `<i class="ms ms-${slug} ms-cost"></i>`
      }).join(' ')
    }

    function applyModeChrome() {
      const mode = MODES[currentMode]
      introText.textContent = mode.intro
      introSub.innerHTML = mode.introSub
      categoryHeading.textContent = mode.categoryHeading
      modeToggle.querySelectorAll('.fc-mode-btn').forEach(btn => {
        const active = btn.dataset.mode === currentMode
        btn.classList.toggle('bg-primary', active)
        btn.classList.toggle('text-on-primary', active)
        btn.classList.toggle('border-transparent', active)
        btn.classList.toggle('bg-white/[0.02]', !active)
        btn.classList.toggle('text-on-surface-variant', !active)
        btn.classList.toggle('border-white/10', !active)
      })
    }

    function refreshStats() {
      const mode = MODES[currentMode]
      const store = progressByMode[currentMode]
      let totalSeen = 0, totalCorrect = 0, mastered = 0, due = 0
      for (const c of currentScopeCards) {
        const p = store[c.key]
        if (p) {
          totalSeen += p.seen
          totalCorrect += p.correct
          if (p.box >= 4) mastered += 1
        }
        if (isDue(c.key)) due += 1
      }
      document.getElementById('fc-stat-sessions').textContent = String(sessionLog.totalSessions)
      document.getElementById('fc-stat-streak').textContent = String(sessionLog.streak)
      document.getElementById('fc-stat-accuracy').textContent = totalSeen ? `${Math.round((100 * totalCorrect) / totalSeen)}%` : '–'
      document.getElementById('fc-stat-mastered').textContent = `${mastered}/${currentScopeCards.length}`

      startBtn.disabled = false
      startBtn.textContent = due > 0
        ? `Start Session — ${due} due`
        : `Practice Full Deck (${currentScopeCards.length} cards)`

      categoryGrid.innerHTML = mode.order.map(catKey => {
        const cardsOfType = currentScopeCards.filter(c => mode.getCategory(c) === catKey)
        const total = cardsOfType.length
        const avgBox = total ? cardsOfType.reduce((s, c) => s + getProgress(c.key).box, 0) / total / 4 * 100 : 0
        const masteredCount = cardsOfType.filter(c => getProgress(c.key).box >= 4).length
        const meta = mode.meta[catKey]
        return `
          <div class="glass-panel rounded-lg p-2.5">
            <div class="text-[11px] font-semibold mb-1.5 truncate" title="${meta.def}">${meta.label}</div>
            <div class="h-1.5 rounded-full bg-white/5 overflow-hidden mb-1">
              <div class="h-full bg-primary" style="width:${avgBox.toFixed(0)}%"></div>
            </div>
            <div class="text-[10px] text-on-surface-variant/70">${masteredCount}/${total} mastered</div>
          </div>
        `
      }).join('')
    }

    async function refreshDashboardForScope(scope) {
      startBtn.disabled = true
      startBtn.textContent = 'Loading…'
      currentScopeCards = await loadScopeCards(scope)
      if (MODES[currentMode].needsPrefetch) {
        startBtn.textContent = 'Reading card text…'
        await ensureQuadrantData(currentScopeCards)
      }
      refreshStats()
    }

    function showDashboard() {
      studyEl.classList.add('hidden')
      dashboardEl.classList.remove('hidden')
      refreshStats()
    }

    function showStudy() {
      dashboardEl.classList.add('hidden')
      studyEl.classList.remove('hidden')
    }

    function buildQueue() {
      const due = currentScopeCards.filter(c => isDue(c.key))
      const pool = due.length > 0 ? due.slice() : currentScopeCards.slice()
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1))
        ;[pool[i], pool[j]] = [pool[j], pool[i]]
      }
      return pool
    }

    function startSession() {
      queue = buildQueue()
      const today = new Date().toDateString()
      if (sessionLog.lastSessionDay !== today) {
        const yesterday = new Date(Date.now() - 86400000).toDateString()
        sessionLog.streak = sessionLog.lastSessionDay === yesterday ? sessionLog.streak + 1 : 1
        sessionLog.totalSessions += 1
        sessionLog.lastSessionDay = today
        storageSet(SESSION_KEY, sessionLog)
      }
      showStudy()
      nextCard()
    }

    function nextCard() {
      answered = false
      picked = null
      if (queue.length === 0) {
        showDashboard()
        return
      }
      current = queue.shift()
      duePill.textContent = `${queue.length + 1} left`
      renderStudyCard()
    }

    function renderStudyCard() {
      const c = current
      const mode = MODES[currentMode]
      const gridCols = mode.order.length > 4 ? 'grid-cols-3' : 'grid-cols-2'
      cardPanel.innerHTML = `
        <div class="flex justify-center mb-3">
          <img src="${c.imageUrl}" alt="${c.name}" class="rounded-xl shadow-lg max-h-80 w-auto" loading="eager" />
        </div>
        <div class="text-lg font-bold text-on-surface mb-0.5">${c.name}</div>
        <div class="flex items-center gap-2 text-xs text-on-surface-variant mb-4">
          <span class="flex items-center gap-1">${manaCostIcons(c.manaCost)}</span>
          <span>&middot;</span>
          <span class="capitalize">${c.typeLine}</span>
          <span>&middot;</span>
          <span class="capitalize">${c.rarity}</span>
        </div>
        <div class="text-[11px] uppercase tracking-widest text-on-surface-variant/60 mb-2">${mode.question}</div>
        <div class="grid ${gridCols} gap-2 mb-4" id="fc-cat-grid">
          ${mode.order.map(catKey => `
            <button data-cat="${catKey}" class="fc-cat-btn px-2 py-3 rounded-lg border border-white/10 bg-white/[0.02] text-on-surface text-sm font-semibold hover:bg-white/[0.06] transition-colors">
              ${mode.meta[catKey].label}
            </button>
          `).join('')}
        </div>
        <div id="fc-action-row">
          <button id="fc-confirm-btn" class="w-full px-4 py-3 rounded-xl bg-primary text-on-primary font-bold text-sm disabled:opacity-40 disabled:cursor-not-allowed" disabled>
            Confirm
          </button>
        </div>
      `
      cardPanel.querySelectorAll('.fc-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (answered) return
          picked = btn.dataset.cat
          cardPanel.querySelectorAll('.fc-cat-btn').forEach(b => {
            b.classList.toggle('ring-2', b === btn)
            b.classList.toggle('ring-primary', b === btn)
          })
          document.getElementById('fc-confirm-btn').disabled = false
        })
      })
      document.getElementById('fc-confirm-btn').addEventListener('click', confirmAnswer)
    }

    function confirmAnswer() {
      if (answered || !picked) return
      answered = true
      const c = current
      const mode = MODES[currentMode]
      const actual = mode.getCategory(c)
      const correct = picked === actual
      const p = getProgress(c.key)
      p.seen += 1
      if (correct) p.correct += 1
      p.lastReviewed = Date.now()
      p.box = correct ? Math.min(4, p.box + 1) : 0
      storageSet(mode.progressKey, progressByMode[currentMode])

      cardPanel.querySelectorAll('.fc-cat-btn').forEach(btn => {
        const catKey = btn.dataset.cat
        btn.classList.remove('ring-2', 'ring-primary')
        if (catKey === actual) btn.classList.add('ring-2', 'ring-emerald-400')
        else if (catKey === picked) btn.classList.add('ring-2', 'ring-red-400')
        btn.disabled = true
      })

      const meta = mode.meta[actual]
      document.getElementById('fc-action-row').innerHTML = `
        <div class="mb-2 font-bold ${correct ? 'text-emerald-400' : 'text-red-400'}">${correct ? 'Correct' : 'Not quite'}</div>
        <div class="text-sm text-on-surface-variant mb-1">
          Actual: <span class="font-semibold ${correct ? 'text-emerald-300' : 'text-primary'}">${meta.label}</span>
          ${currentMode === 'bread' ? `&middot; Karn power score <span class="font-semibold text-on-surface">${Number(c.power_score).toFixed(1)}</span>` : ''}
        </div>
        <p class="text-sm text-on-surface-variant/80 leading-snug mb-3">${meta.def}</p>
        <a href="${scryfallSearchUrl(c.name)}" target="_blank" rel="noopener" class="block text-center text-xs italic text-on-surface-variant hover:text-primary transition-colors mb-3">View on Scryfall &#8599;</a>
        <button id="fc-next-btn" class="w-full px-4 py-3 rounded-xl bg-primary text-on-primary font-bold text-sm">Next card</button>
      `
      document.getElementById('fc-next-btn').addEventListener('click', nextCard)
    }

    async function switchMode(nextMode) {
      if (nextMode === currentMode) return
      currentMode = nextMode
      storageSet(MODE_KEY, currentMode)
      applyModeChrome()
      await refreshDashboardForScope(setSelect.value)
    }

    modeToggle.querySelectorAll('.fc-mode-btn').forEach(btn => {
      btn.addEventListener('click', () => switchMode(btn.dataset.mode))
    })
    setSelect.addEventListener('change', () => refreshDashboardForScope(setSelect.value))
    startBtn.addEventListener('click', startSession)
    backBtn.addEventListener('click', showDashboard)

    ;(async function init() {
      currentMode = storageGet(MODE_KEY, 'bread')
      if (!MODES[currentMode]) currentMode = 'bread'
      progressByMode.bread = storageGet(MODES.bread.progressKey, {})
      progressByMode.quadrant = storageGet(MODES.quadrant.progressKey, {})
      sessionLog = storageGet(SESSION_KEY, sessionLog)
      applyModeChrome()
      await loadManifest()
      setSelect.value = 'ALL'
      await refreshDashboardForScope('ALL')
    })()
  </script>
</BaseLayout>
