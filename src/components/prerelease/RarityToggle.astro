---
import { t, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const i18n = t(lang)
---

<button
  id="rarity-toggle"
  type="button"
  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-surface/60 text-xs font-semibold text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap"
  aria-pressed="false"
>
  <span>{i18n.rarityToggleShowLabel}</span>
  <span id="rarity-toggle-state" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border bg-emerald-400/15 text-emerald-300 border-emerald-400/30">
    <span id="rarity-toggle-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
    <span id="rarity-toggle-state-text">{i18n.rarityToggleOnLabel}</span>
  </span>
</button>

<style is:global>
  :root:not([data-rarity-view]) .rarity-commonsOnly-only,
  [data-rarity-view='all'] .rarity-commonsOnly-only { display: none; }
  [data-rarity-view='commonsOnly'] .rarity-all-only { display: none; }
</style>

<script define:vars={{ onLabel: i18n.rarityToggleOnLabel, offLabel: i18n.rarityToggleOffLabel }}>
  const STORAGE_KEY = 'karn-rarity-view'
  const btn = document.getElementById('rarity-toggle')
  const stateBadge = document.getElementById('rarity-toggle-state')
  const dot = document.getElementById('rarity-toggle-dot')
  const stateText = document.getElementById('rarity-toggle-state-text')

  const ON_CLASSES = ['bg-emerald-400/15', 'text-emerald-300', 'border-emerald-400/30']
  const OFF_CLASSES = ['bg-red-400/15', 'text-red-300', 'border-red-400/30']

  function apply(view) {
    document.documentElement.dataset.rarityView = view
    const showingRares = view !== 'commonsOnly'
    if (stateText) stateText.textContent = showingRares ? onLabel : offLabel
    if (dot) dot.className = `w-1.5 h-1.5 rounded-full ${showingRares ? 'bg-emerald-400' : 'bg-red-400'}`
    if (stateBadge) {
      stateBadge.classList.remove(...ON_CLASSES, ...OFF_CLASSES)
      stateBadge.classList.add(...(showingRares ? ON_CLASSES : OFF_CLASSES))
    }
    if (btn) btn.setAttribute('aria-pressed', String(!showingRares))
  }

  const stored = localStorage.getItem(STORAGE_KEY)
  apply(stored === 'commonsOnly' ? 'commonsOnly' : 'all')

  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.rarityView === 'commonsOnly' ? 'all' : 'commonsOnly'
    localStorage.setItem(STORAGE_KEY, next)
    apply(next)
  })
</script>
