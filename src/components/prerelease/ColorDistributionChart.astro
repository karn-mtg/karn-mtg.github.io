---
import ManaSymbol from './ManaSymbol.astro'

interface ColorBucket {
  total: number
  creature: number
  nonCreature: number
}

interface Props {
  byColor: Record<string, ColorBucket>
  creatureLabel: string
  nonCreatureLabel: string
}

const { byColor, creatureLabel, nonCreatureLabel } = Astro.props

const ORDER = ['W', 'U', 'B', 'R', 'G', 'multi', 'C'] as const
const COLOR_HEX: Record<string, string> = {
  W: '#e8e4d0',
  U: '#5b9bd5',
  B: '#8b7fb0',
  R: '#e0654a',
  G: '#5a9e6f',
  multi: '#f2ca83',
  C: '#9a8f80',
}
const rows = ORDER.filter(key => byColor[key]).map(key => ({ key, ...byColor[key] }))
const maxTotal = Math.max(1, ...rows.map(r => r.total))
---

<div class="glass-panel rounded-xl p-6">
  <div class="flex flex-col gap-2.5">
    {rows.map(row => (
      <div class="flex items-center gap-3">
        <span class="w-6 flex-shrink-0 flex items-center justify-center">
          <ManaSymbol color={row.key} />
        </span>
        <div class="flex-1 h-[26px] rounded-md overflow-hidden bg-white/5 relative">
          <div
            class="h-full absolute inset-y-0 left-0 rounded-md"
            style={`width:${(row.creature / maxTotal) * 100}%; background-color:${COLOR_HEX[row.key]}`}
          />
          <div
            class="h-full absolute inset-y-0"
            style={`left:${(row.creature / maxTotal) * 100}%; width:${(row.nonCreature / maxTotal) * 100}%; background-color:${COLOR_HEX[row.key]}; opacity:0.35`}
          />
        </div>
        <span class="w-7 flex-shrink-0 text-right text-xs text-on-surface-variant">{row.total}</span>
      </div>
    ))}
  </div>
  <div class="mt-4 flex items-center gap-6 text-xs text-on-surface-variant/70">
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-primary inline-block" />{creatureLabel}</span>
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-primary/35 inline-block" />{nonCreatureLabel}</span>
  </div>
</div>
