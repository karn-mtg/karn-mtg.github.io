---
import { t, type Lang } from '../../i18n'

interface Props {
  bread: { bomb: number; removal: number; evasion: number; aggro: number; diversity: number; overall: number; tags: string[] }
  lang: Lang
}

const { bread, lang } = Astro.props
const i18n = t(lang)

const LABEL: Record<string, string> = {
  bomb: i18n.breadBombLabel,
  removal: i18n.breadRemovalLabel,
  evasion: i18n.breadEvasionLabel,
  aggro: i18n.breadAggroLabel,
  diversity: i18n.breadDiversityLabel,
}
const COLOR: Record<string, string> = {
  bomb: 'bg-primary/15 text-primary border-primary/30',
  removal: 'bg-red-400/15 text-red-300 border-red-400/30',
  evasion: 'bg-sky-400/15 text-sky-300 border-sky-400/30',
  aggro: 'bg-orange-400/15 text-orange-300 border-orange-400/30',
  diversity: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30',
}

const scoreByCategory: Record<string, number> = {
  bomb: bread.bomb,
  removal: bread.removal,
  evasion: bread.evasion,
  aggro: bread.aggro,
  diversity: bread.diversity,
}
const activeTags = bread.tags.filter(tag => tag !== 'filler')
---

<div class="flex flex-wrap items-center gap-1.5">
  {activeTags.length > 0 ? (
    activeTags.map(tag => (
      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border ${COLOR[tag]}`}>
        {LABEL[tag]} {scoreByCategory[tag]}
      </span>
    ))
  ) : (
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border bg-white/5 text-on-surface-variant/60 border-white/10">
      {i18n.breadFillerLabel}
    </span>
  )}
  <span class="ml-1 text-[11px] font-semibold text-on-surface-variant/50">
    {i18n.breadOverallLabel} {bread.overall}
  </span>
</div>
