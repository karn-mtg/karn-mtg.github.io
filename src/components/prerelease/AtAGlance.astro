---
import { t, type Lang } from '../../i18n'
import ColorDistributionChart from './ColorDistributionChart.astro'
import RarityBar from './RarityBar.astro'
import BreadScorePills from './BreadScorePills.astro'
import ManaSymbol from './ManaSymbol.astro'

interface Props {
  lang: Lang
  cardCount: number
  byRarity: Record<string, number>
  byColor: Record<string, { total: number; creature: number; nonCreature: number }>
  boosterOdds: Record<string, { duplicateChance: number }>
  rarityLabels: Record<string, string>
  topCard?: {
    name: string
    image?: string
    bread: { bomb: number; removal: number; evasion: number; aggro: number; diversity: number; overall: number; tags: string[] }
  }
  topCombo?: { colors: string; avgBomb: number }
}

const { lang, cardCount, byRarity, byColor, boosterOdds, rarityLabels, topCard, topCombo } = Astro.props
const i18n = t(lang)

const RARITY_COLOR_HEX: Record<string, string> = {
  common: '#9a8f80',
  uncommon: '#7ea9c9',
  rare: '#e0b04a',
  mythic: '#e0654a',
}
---

<div class="grid gap-6 lg:grid-cols-5 mb-16">
  <div class="lg:col-span-3 glass-panel rounded-2xl p-6">
    <h3 class="text-sm font-semibold uppercase tracking-widest text-on-surface-variant/50 mb-4">{i18n.colorDistributionHeading}</h3>
    <ColorDistributionChart
      byColor={byColor}
      creatureLabel={i18n.colorDistributionCreature}
      nonCreatureLabel={i18n.colorDistributionNonCreature}
    />
  </div>

  <div class="lg:col-span-2 flex flex-col gap-4">
    <RarityBar cardCount={cardCount} byRarity={byRarity} rarityLabels={rarityLabels} cardCountLabel={i18n.prereleaseCardCount(cardCount)} />

    <div class="glass-panel rounded-xl px-4 py-3">
      <div class="text-sm font-bold text-on-surface mb-2">{i18n.repeatChanceHeading}</div>
      <div class="flex items-start gap-4">
        {Object.entries(boosterOdds).map(([rarity, odds]) => (
          <div class="text-center">
            <div class="text-base font-semibold" style={`color:${RARITY_COLOR_HEX[rarity] ?? 'inherit'}`}>
              {odds.duplicateChance}%
            </div>
            <div class="text-[10px] uppercase tracking-widest text-on-surface-variant/60 mt-0.5">
              {rarityLabels[rarity] ?? rarity}
            </div>
          </div>
        ))}
      </div>
    </div>

    {topCard && (
      <a href="#bread" class="glass-panel rounded-xl p-4 block hover:border-primary/30 transition-colors" data-card-name={topCard.name}>
        <div class="flex items-center gap-3">
          {topCard.image && <img src={topCard.image} alt={topCard.name} class="w-12 h-auto rounded-md flex-shrink-0" />}
          <div class="min-w-0">
            <div class="text-[10px] uppercase tracking-widest text-on-surface-variant/50">{i18n.bestCardsHeading}</div>
            <div class="font-bold text-on-surface truncate">{topCard.name}</div>
            <BreadScorePills bread={topCard.bread} lang={lang} />
          </div>
        </div>
      </a>
    )}

    {topCombo && (
      <a href="#bread" class="glass-panel rounded-xl p-4 flex items-center justify-between hover:border-primary/30 transition-colors">
        <div>
          <div class="text-[10px] uppercase tracking-widest text-on-surface-variant/50 mb-1">{i18n.manaCombosHeading}</div>
          <div class="flex gap-0.5">
            {topCombo.colors.split('').map(c => <ManaSymbol color={c} />)}
          </div>
        </div>
        <span class="text-lg font-bold text-primary">{topCombo.avgBomb}</span>
      </a>
    )}
  </div>
</div>
