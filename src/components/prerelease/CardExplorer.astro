---
import { t, type Lang } from '../../i18n'
import BreadScorePills from './BreadScorePills.astro'

interface CardEntry {
  name: string
  oracleId: string
  manaCost: string
  typeLine: string
  colorIdentity: string[]
  rarity: string
  image?: string
  bread: { bomb: number; removal: number; evasion: number; aggro: number; diversity: number; overall: number; tags: string[] }
}

interface Props {
  cards: CardEntry[]
  lang: Lang
}

const { cards, lang } = Astro.props
const i18n = t(lang)

const PAGE_SIZE = 24

const TAG_FILTERS = ['bomb', 'removal', 'evasion', 'aggro', 'diversity', 'filler'] as const
const TAG_LABEL: Record<string, string> = {
  bomb: i18n.breadBombLabel,
  removal: i18n.breadRemovalLabel,
  evasion: i18n.breadEvasionLabel,
  aggro: i18n.breadAggroLabel,
  diversity: i18n.breadDiversityLabel,
  filler: i18n.breadFillerLabel,
}

const sorted = [...cards].sort((a, b) => b.bread.overall - a.bread.overall)
---

<div id="card-explorer" data-page-size={PAGE_SIZE}>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="flex flex-wrap gap-2" id="bread-tag-filter">
      <button
        data-tag="all"
        class="tag-filter-btn inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold transition-colors duration-150 bg-primary text-on-primary active"
      >
        {i18n.explorerFilterAll}
      </button>
      {TAG_FILTERS.map(tag => (
        <button
          data-tag={tag}
          class="tag-filter-btn inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold transition-colors duration-150 bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20"
        >
          {TAG_LABEL[tag]}
        </button>
      ))}
    </div>
    <span class="text-xs text-on-surface-variant/50" id="explorer-count"></span>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="card-grid">
    {sorted.map(card => (
      <div
        class="card-item glass-panel rounded-xl overflow-hidden flex gap-3 p-3"
        data-tags={card.bread.tags.join(',')}
        data-colors={(card.colorIdentity.length ? card.colorIdentity : ['C']).join(',')}
      >
        {card.image && (
          <img src={card.image} alt={card.name} class="w-16 h-auto rounded-md flex-shrink-0" loading="lazy" />
        )}
        <div class="min-w-0">
          <div class="flex items-baseline justify-between gap-2">
            <h4 class="font-semibold text-sm text-on-surface truncate">{card.name}</h4>
            <span class="text-[11px] text-on-surface-variant/60 flex-shrink-0">{card.manaCost}</span>
          </div>
          <p class="text-[11px] text-on-surface-variant/70 mb-2 truncate">{card.typeLine}</p>
          <BreadScorePills bread={card.bread} lang={lang} />
        </div>
      </div>
    ))}
  </div>

  <div id="explorer-no-results" class="hidden text-center py-16 text-on-surface-variant/50">
    {i18n.explorerNoResults}
  </div>

  <div class="flex items-center justify-center gap-4 mt-8" id="explorer-pagination">
    <button
      id="explorer-prev"
      class="px-4 py-2 rounded-lg border border-white/10 text-sm font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors disabled:opacity-30 disabled:pointer-events-none"
    >
      ←
    </button>
    <span class="text-sm text-on-surface-variant/70" id="explorer-page-label"></span>
    <button
      id="explorer-next"
      class="px-4 py-2 rounded-lg border border-white/10 text-sm font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors disabled:opacity-30 disabled:pointer-events-none"
    >
      →
    </button>
  </div>
</div>

<script>
  const root = document.getElementById('card-explorer') as HTMLElement
  const pageSize = Number(root.dataset.pageSize) || 24

  const btns = document.querySelectorAll<HTMLButtonElement>('#bread-tag-filter .tag-filter-btn')
  const items = Array.from(document.querySelectorAll<HTMLElement>('#card-grid .card-item'))
  const noResults = document.getElementById('explorer-no-results')
  const countEl = document.getElementById('explorer-count')
  const pageLabel = document.getElementById('explorer-page-label')
  const prevBtn = document.getElementById('explorer-prev') as HTMLButtonElement
  const nextBtn = document.getElementById('explorer-next') as HTMLButtonElement

  let activeTag = 'all'
  let page = 1

  function matches(item: HTMLElement) {
    const tags = item.dataset.tags?.split(',') ?? []
    return activeTag === 'all' || tags.includes(activeTag)
  }

  function render() {
    const visible = items.filter(matches)
    const totalPages = Math.max(1, Math.ceil(visible.length / pageSize))
    page = Math.min(page, totalPages)
    const start = (page - 1) * pageSize
    const end = start + pageSize

    let shownCount = 0
    items.forEach(item => {
      const isMatch = matches(item)
      const index = isMatch ? visible.indexOf(item) : -1
      const show = isMatch && index >= start && index < end
      item.style.display = show ? '' : 'none'
      if (show) shownCount++
    })

    if (noResults) noResults.classList.toggle('hidden', visible.length > 0)
    if (countEl) countEl.textContent = `${visible.length}`
    if (pageLabel) pageLabel.textContent = `${page} / ${totalPages}`
    prevBtn.disabled = page <= 1
    nextBtn.disabled = page >= totalPages

    const pagination = document.getElementById('explorer-pagination')
    if (pagination) pagination.style.display = totalPages <= 1 ? 'none' : ''
  }

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag!
      page = 1
      btns.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary', 'active')
        b.classList.add('bg-primary/10', 'text-primary', 'hover:bg-primary/20', 'border', 'border-primary/20')
      })
      btn.classList.add('bg-primary', 'text-on-primary', 'active')
      btn.classList.remove('bg-primary/10', 'text-primary', 'hover:bg-primary/20', 'border', 'border-primary/20')
      render()
    })
  })

  prevBtn.addEventListener('click', () => {
    page = Math.max(1, page - 1)
    render()
    root.scrollIntoView({ block: 'start', behavior: 'smooth' })
  })
  nextBtn.addEventListener('click', () => {
    page += 1
    render()
    root.scrollIntoView({ block: 'start', behavior: 'smooth' })
  })

  render()
</script>
