---
interface Props {
  sections: { id: string; label: string }[]
}

const { sections } = Astro.props
---

<nav class="sticky top-20 z-10 -mx-6 px-6 py-3 mb-10 bg-background/80 backdrop-blur-md border-y border-white/5">
  <div class="flex items-center gap-4">
    <div class="flex gap-2 w-max overflow-x-auto">
      {sections.map(s => (
        <a
          href={`#${s.id}`}
          class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold text-on-surface-variant/70 hover:text-primary hover:bg-primary/10 transition-colors border border-white/10"
        >
          {s.label}
        </a>
      ))}
    </div>
    <div class="ml-auto shrink-0">
      <slot />
    </div>
  </div>
</nav>
