---
import { t, type Lang } from '../../i18n'

interface Props {
  mechanics: { mechanic: string; count: number; synergyCount: number; description?: string }[]
  lang: Lang
}

const { mechanics, lang } = Astro.props
const i18n = t(lang)

const PAGE_SIZE = 9
---

<div class="mechanics-list-root" data-page-size={PAGE_SIZE}>
  <div class="mechanics-grid grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
    {mechanics.map(({ mechanic, count, synergyCount, description }) => (
      <div class="mechanic-item glass-panel rounded-lg px-4 py-2.5">
        <div class="flex items-center justify-between gap-2">
          <span class="text-sm font-semibold text-on-surface truncate">{mechanic}</span>
          <span class="text-xs font-semibold text-primary flex-shrink-0">{count} {i18n.mechanicsCardsUnit}</span>
        </div>
        <div class="mt-1.5 flex items-center gap-2">
          <div class="flex-1 h-1.5 rounded-full bg-white/5 overflow-hidden" title={i18n.mechanicsSynergyBarTitle}>
            <div class="h-full bg-primary rounded-full" style={`width:${(synergyCount / count) * 100}%`} />
          </div>
          <span class="text-[10px] text-on-surface-variant/50 flex-shrink-0">{synergyCount}/{count} {i18n.mechanicsSynergySuffix}</span>
        </div>
        {description && <p class="text-xs text-on-surface-variant/60 mt-1.5 leading-relaxed">{description}</p>}
      </div>
    ))}
  </div>

  <div class="mechanics-pagination flex items-center justify-center gap-4 mt-6">
    <button
      class="mechanics-prev px-4 py-2 rounded-lg border border-white/10 text-sm font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors disabled:opacity-30 disabled:pointer-events-none"
    >
      ←
    </button>
    <span class="mechanics-page-label text-sm text-on-surface-variant/70"></span>
    <button
      class="mechanics-next px-4 py-2 rounded-lg border border-white/10 text-sm font-semibold text-on-surface-variant hover:text-on-surface hover:bg-white/5 transition-colors disabled:opacity-30 disabled:pointer-events-none"
    >
      →
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.mechanics-list-root').forEach(root => {
    const pageSize = Number(root.dataset.pageSize) || 9
    const items = Array.from(root.querySelectorAll<HTMLElement>('.mechanic-item'))
    const pagination = root.querySelector<HTMLElement>('.mechanics-pagination')
    const pageLabel = root.querySelector<HTMLElement>('.mechanics-page-label')
    const prevBtn = root.querySelector<HTMLButtonElement>('.mechanics-prev')
    const nextBtn = root.querySelector<HTMLButtonElement>('.mechanics-next')
    if (!prevBtn || !nextBtn) return

    let page = 1
    const totalPages = Math.max(1, Math.ceil(items.length / pageSize))

    function render() {
      const start = (page - 1) * pageSize
      const end = start + pageSize
      items.forEach((item, index) => {
        item.style.display = index >= start && index < end ? '' : 'none'
      })
      if (pageLabel) pageLabel.textContent = `${page} / ${totalPages}`
      prevBtn!.disabled = page <= 1
      nextBtn!.disabled = page >= totalPages
      if (pagination) pagination.style.display = totalPages <= 1 ? 'none' : ''
    }

    prevBtn.addEventListener('click', () => {
      page = Math.max(1, page - 1)
      render()
      root.scrollIntoView({ block: 'start', behavior: 'smooth' })
    })
    nextBtn.addEventListener('click', () => {
      page = Math.min(totalPages, page + 1)
      render()
      root.scrollIntoView({ block: 'start', behavior: 'smooth' })
    })

    render()
  })
</script>
