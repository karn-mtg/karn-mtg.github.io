---
import { t, type Lang } from '../../i18n'

interface Combo {
  mechanics: string[]
  count: number
  examples: string[]
  verdict: 'confirmed' | 'coincidental' | 'unclear'
  mechanism?: string
}

interface Props {
  combos: Combo[]
  lang: Lang
}

const { combos, lang } = Astro.props
const i18n = t(lang)

const shown = combos.filter(c => c.verdict !== 'coincidental')
const coincidental = combos.filter(c => c.verdict === 'coincidental')

const VERDICT_STYLE: Record<string, string> = {
  confirmed: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30',
  unclear: 'bg-on-surface-variant/10 text-on-surface-variant border-on-surface-variant/20',
}
---

<div class="grid gap-3 sm:grid-cols-2">
  {shown.map(combo => (
    <div class="glass-panel rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-on-surface">{combo.mechanics.join(' + ')}</span>
        <span class="text-xs font-semibold text-primary">{combo.count} cards</span>
      </div>
      {combo.verdict === 'confirmed' && (
        <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border mb-2 ${VERDICT_STYLE.confirmed}`}>
          {i18n.synergyConfirmedLabel}
        </span>
      )}
      {combo.mechanism && (
        <p class="text-xs text-on-surface-variant/80 mb-2">{combo.mechanism}</p>
      )}
      <p class="text-xs text-on-surface-variant/70 truncate">
        {combo.examples.map((name, i) => (
          <>
            {i > 0 && ', '}
            <span class="cursor-default" data-card-name={name}>{name}</span>
          </>
        ))}
      </p>
    </div>
  ))}
</div>

{coincidental.length > 0 && (
  <details class="mt-4">
    <summary class="text-xs text-on-surface-variant/60 cursor-pointer">
      {i18n.synergyCoincidentalLabel} ({coincidental.length})
    </summary>
    <div class="grid gap-3 sm:grid-cols-2 mt-3">
      {coincidental.map(combo => (
        <div class="glass-panel rounded-xl p-4 opacity-60">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold text-on-surface">{combo.mechanics.join(' + ')}</span>
            <span class="text-xs font-semibold text-primary">{combo.count} cards</span>
          </div>
          <p class="text-xs text-on-surface-variant/70 truncate">
        {combo.examples.map((name, i) => (
          <>
            {i > 0 && ', '}
            <span class="cursor-default" data-card-name={name}>{name}</span>
          </>
        ))}
      </p>
        </div>
      ))}
    </div>
  </details>
)}
