---
interface Row {
  label: string
  byColor: Record<string, number>
}

interface Props {
  rows: Row[]
  columns?: string[]
}

const { rows, columns = ['W', 'U', 'B', 'R', 'G', 'multi', 'C'] } = Astro.props
const maxValue = Math.max(1, ...rows.flatMap(r => columns.map(c => r.byColor[c] || 0)))

function cellStyle(value: number) {
  const alpha = value === 0 ? 0 : 0.15 + (value / maxValue) * 0.7
  return `background: rgba(242, 202, 131, ${alpha})`
}
---

<div class="glass-panel rounded-xl p-4 overflow-x-auto">
  <table class="w-full text-xs border-collapse">
    <thead>
      <tr>
        <th class="text-left font-semibold text-on-surface-variant/60 pb-2 pr-3 sticky left-0 bg-surface">&nbsp;</th>
        {columns.map(col => (
          <th class="font-semibold text-on-surface-variant/60 pb-2 px-2 text-center min-w-[2.5rem]">{col}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          <td class="pr-3 py-1 font-semibold text-on-surface whitespace-nowrap sticky left-0 bg-surface">{row.label}</td>
          {columns.map(col => (
            <td class="text-center py-1 px-2 rounded text-on-surface" style={cellStyle(row.byColor[col] || 0)}>
              {row.byColor[col] || ''}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
