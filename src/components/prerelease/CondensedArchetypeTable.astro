---
import { t, type Lang } from '../../i18n'
import ManaSymbol from './ManaSymbol.astro'

interface Archetype {
  colors: string
  name: string
  mechanic: string
  supportCardCount: number
  probabilityPlayable: number
  avgQuality: number
  setWideAvgQuality: number
  verdict: 'wellSupported' | 'plentifulButWeak' | 'rareButStrong' | 'dataDisagrees' | 'insufficient'
  alternativeSignal: { mechanic: string; cardCount: number; avgOverall: number } | null
}

interface Props {
  archetypes: Archetype[]
  lang: Lang
}

const { archetypes, lang } = Astro.props
const i18n = t(lang)

const VERDICT_LABEL: Record<string, string> = {
  wellSupported: i18n.verdictWellSupported,
  plentifulButWeak: i18n.verdictPlentifulButWeak,
  rareButStrong: i18n.verdictRareButStrong,
  dataDisagrees: i18n.verdictDataDisagrees,
  insufficient: i18n.verdictInsufficient,
}
const VERDICT_STYLE: Record<string, string> = {
  wellSupported: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/30',
  plentifulButWeak: 'bg-amber-400/15 text-amber-300 border-amber-400/30',
  rareButStrong: 'bg-sky-400/15 text-sky-300 border-sky-400/30',
  dataDisagrees: 'bg-red-400/15 text-red-300 border-red-400/30',
  insufficient: 'bg-red-400/15 text-red-300 border-red-400/30',
}
---

<div class="glass-panel rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-[10px] uppercase tracking-widest text-on-surface-variant/50 border-b border-white/5">
        <th class="px-4 py-3 font-semibold">{i18n.colorsColumnLabel}</th>
        <th class="px-4 py-3 font-semibold">Archetype</th>
        <th class="px-3 py-3 font-semibold text-right">{i18n.supportCardsLabel}</th>
        <th class="px-3 py-3 font-semibold text-right">{i18n.feasibilityLabel}</th>
        <th class="px-3 py-3 font-semibold text-right">{i18n.qualityLabel}</th>
        <th class="px-3 py-3 font-semibold text-right">Verdict</th>
      </tr>
    </thead>
    <tbody>
      {archetypes.map(arch => (
        <tr class="border-b border-white/5 last:border-0 align-top">
          <td class="px-4 py-2.5">
            <div class="flex gap-0.5">{arch.colors.split('').map(c => <ManaSymbol color={c} />)}</div>
          </td>
          <td class="px-4 py-2.5">
            <div class="font-semibold text-on-surface">{arch.name}</div>
            <div class="text-xs text-on-surface-variant/50">{arch.mechanic}</div>
            {arch.alternativeSignal && (
              <div class="text-[11px] text-amber-300/90 mt-1">
                {i18n.alternativeSignalLabel} {arch.alternativeSignal.mechanic} ({arch.alternativeSignal.cardCount})
              </div>
            )}
          </td>
          <td class="px-3 py-2.5 text-right text-on-surface-variant">{arch.supportCardCount}</td>
          <td class="px-3 py-2.5 text-right text-on-surface-variant">{arch.probabilityPlayable}%</td>
          <td class="px-3 py-2.5 text-right text-on-surface-variant">{arch.avgQuality} <span class="text-on-surface-variant/40 text-xs">/{arch.setWideAvgQuality}</span></td>
          <td class="px-3 py-2.5 text-right">
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border ${VERDICT_STYLE[arch.verdict]}`}>
              {VERDICT_LABEL[arch.verdict]}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
