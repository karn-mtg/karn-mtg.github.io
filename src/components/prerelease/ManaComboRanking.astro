---
import ManaSymbol from './ManaSymbol.astro'

interface Combo {
  colors: string
  cardCount: number
  avgBomb: number
  avgOverall: number
  topCards: string[]
}

interface Props {
  combos: Combo[]
}

const { combos } = Astro.props
---

<div class="grid gap-3 sm:grid-cols-2">
  {combos.map(combo => (
    <div class="glass-panel rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <div class="flex gap-0.5">
          {combo.colors.split('').map(c => <ManaSymbol color={c} />)}
        </div>
        <span class="text-xs font-semibold text-primary">{combo.avgBomb}</span>
      </div>
      <p class="text-[11px] text-on-surface-variant/60 mb-1">{combo.cardCount} cards · avg overall {combo.avgOverall}</p>
      <p class="text-xs text-on-surface-variant truncate">
        {combo.topCards.map((name, i) => (
          <>
            {i > 0 && ', '}
            <span class="cursor-default" data-card-name={name}>{name}</span>
          </>
        ))}
      </p>
    </div>
  ))}
</div>
