---
import { t, type Lang } from '../../i18n'
import ManaSymbol from './ManaSymbol.astro'

interface Combo {
  colors: string
  cardCount: number
  avgBomb: number
  avgOverall: number
  topCards: string[]
  rawScorePercent: number
  curveFitPercent: number
  deckPullChancePercent: number
  synergyPercent: number
  finalScore: number
}

interface Props {
  combos: Combo[]
  lang: Lang
}

const { combos, lang } = Astro.props
const i18n = t(lang)

const SUB_SCORES: { key: keyof Combo; label: string }[] = [
  { key: 'rawScorePercent', label: i18n.comboRawScoreLabel },
  { key: 'curveFitPercent', label: i18n.comboCurveFitLabel },
  { key: 'deckPullChancePercent', label: i18n.comboPullChanceLabel },
  { key: 'synergyPercent', label: i18n.comboSynergyLabel },
]
---

<div class="grid gap-3 sm:grid-cols-2">
  {combos.map(combo => (
    <div class="glass-panel rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <div class="flex gap-0.5">
          {combo.colors.split('').map(c => <ManaSymbol color={c} />)}
        </div>
        <div class="text-right">
          <div class="text-lg font-bold text-primary leading-none">{combo.finalScore}</div>
          <div class="text-[9px] uppercase tracking-widest text-on-surface-variant/50">{i18n.comboFinalScoreLabel}</div>
        </div>
      </div>
      <p class="text-[11px] text-on-surface-variant/60 mb-2">
        {combo.cardCount > 0
          ? i18n.comboGoldCardsCaption(combo.cardCount, combo.avgBomb, combo.avgOverall)
          : i18n.comboNoGoldCardsCaption}
      </p>

      <div class="grid grid-cols-4 gap-2 mb-3">
        {SUB_SCORES.map(({ key, label }) => (
          <div>
            <div class="h-1 rounded-full bg-white/5 overflow-hidden mb-1">
              <div class="h-full bg-primary/70 rounded-full" style={`width:${combo[key]}%`} />
            </div>
            <div class="text-[9px] text-on-surface-variant/50 truncate" title={label}>{label}</div>
            <div class="text-[10px] font-semibold text-on-surface-variant">{combo[key]}%</div>
          </div>
        ))}
      </div>

      {combo.topCards.length > 0 && (
        <p class="text-xs text-on-surface-variant truncate">
          {combo.topCards.map((name, i) => (
            <>
              {i > 0 && ', '}
              <span class="cursor-default" data-card-name={name}>{name}</span>
            </>
          ))}
        </p>
      )}
    </div>
  ))}
</div>
